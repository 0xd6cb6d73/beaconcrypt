(* SPDX-License-Identifier: 0BSD *)

(* The compromise is taken after failed admission and full-cache rejection,
   before a later legitimate delivery.  The correspondence suite proves the
   ordering; these two queries require concrete witnesses. *)
query session: bitstring,
      target_sequence: sequence,
      retained_state: bitstring,
      full_state: bitstring;
  event(FailedReceiveStateCompromised(
    session,
    target_sequence,
    retained_state,
    full_state
  )).

query session: bitstring,
      target_sequence: sequence,
      sender: key_id,
      receiver: key_id,
      accepted_frame: bitstring,
      target_material: bitstring,
      forged_frame: bitstring,
      ready_state: bitstring,
      retained_state: bitstring,
      full_state: bitstring,
      consumed_state: bitstring;
  event(FailedReceiveHonestDelivery(
    session,
    target_sequence,
    sender,
    receiver,
    FAILED_TARGET_SECRET,
    accepted_frame,
    target_material,
    forged_frame,
    ready_state,
    retained_state,
    full_state,
    consumed_state
  )).
