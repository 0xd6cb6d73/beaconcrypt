(* SPDX-License-Identifier: 0BSD *)

(* A failed admitted future receive retains state but does not expose any
   application plaintext while the resulting receiver state stays private. *)
query attacker(FAILED_PAST_SECRET).
query attacker(FAILED_SKIPPED_SECRET).
query attacker(FAILED_TARGET_SECRET).
query attacker(FAILED_FUTURE_SECRET).

(* Authentication failure is recorded only after the exact target capability
   has been inserted into the explicit receive cache. *)
query session: bitstring,
      target_sequence: sequence,
      target_material: bitstring,
      forged_frame: bitstring,
      ready_state: bitstring,
      retained_state: bitstring;
  inj-event(FailedReceiveStateAdvanced(
    session,
    target_sequence,
    target_material,
    forged_frame,
    ready_state,
    retained_state
  )) ==>
  inj-event(MessageKeyCached(
    session,
    beacon_role(),
    server_to_beacon(),
    target_sequence,
    target_material
  )).

(* Retrying the exact invalid frame sees the state retained by the first
   failed open; the later cache fill does not delete that target capability. *)
query session: bitstring,
      target_sequence: sequence,
      target_material: bitstring,
      forged_frame: bitstring,
      ready_state: bitstring,
      retained_state: bitstring,
      full_state: bitstring;
  inj-event(FailedReceiveRetryRetained(
    session,
    target_sequence,
    target_material,
    forged_frame,
    ready_state,
    retained_state,
    full_state
  )) ==>
  inj-event(FailedReceiveStateAdvanced(
    session,
    target_sequence,
    target_material,
    forged_frame,
    ready_state,
    retained_state
  )).

(* Capacity rejection uses exactly the state produced by the preceding failed
   cache-fill authentication; no receive transition is substituted. *)
query session: bitstring,
      target_sequence: sequence,
      capacity_sequence: sequence,
      capacity_frame: bitstring,
      retained_state: bitstring,
      full_state: bitstring;
  inj-event(FailedReceiveCapacityRejected(
    session,
    target_sequence,
    capacity_sequence,
    capacity_frame,
    retained_state,
    full_state
  )) ==>
  inj-event(FailedReceiveCacheFilled(
    session,
    retained_state,
    full_state
  )).

(* A successful later open uses the retained target capability and begins
   from the same full state as the failed retry. *)
query session: bitstring,
      target_sequence: sequence,
      sender: key_id,
      receiver: key_id,
      plaintext: bitstring,
      accepted_frame: bitstring,
      target_material: bitstring,
      forged_frame: bitstring,
      ready_state: bitstring,
      retained_state: bitstring,
      full_state: bitstring,
      consumed_state: bitstring;
  inj-event(FailedReceiveAccepted(
    session,
    target_sequence,
    sender,
    receiver,
    plaintext,
    accepted_frame,
    target_material,
    forged_frame,
    ready_state,
    retained_state,
    full_state,
    consumed_state
  )) ==>
  inj-event(FailedReceiveRetryRetained(
    session,
    target_sequence,
    target_material,
    forged_frame,
    ready_state,
    retained_state,
    full_state
  )).

(* Successful authentication removes exactly the retained target capability. *)
query session: bitstring,
      target_sequence: sequence,
      sender: key_id,
      receiver: key_id,
      plaintext: bitstring,
      accepted_frame: bitstring,
      target_material: bitstring,
      forged_frame: bitstring,
      ready_state: bitstring,
      retained_state: bitstring,
      full_state: bitstring,
      consumed_state: bitstring;
  inj-event(FailedReceiveAccepted(
    session,
    target_sequence,
    sender,
    receiver,
    plaintext,
    accepted_frame,
    target_material,
    forged_frame,
    ready_state,
    retained_state,
    full_state,
    consumed_state
  )) ==>
  inj-event(FailedReceiveKeyConsumed(
    session,
    target_sequence,
    full_state,
    consumed_state
  )).

(* Once the successful receive has moved to consumed_state, rejection of the
   byte-for-byte frame replay is tied to that exact accepted record. *)
query session: bitstring,
      target_sequence: sequence,
      sender: key_id,
      receiver: key_id,
      plaintext: bitstring,
      accepted_frame: bitstring,
      target_material: bitstring,
      forged_frame: bitstring,
      ready_state: bitstring,
      retained_state: bitstring,
      full_state: bitstring,
      consumed_state: bitstring;
  inj-event(FailedReceiveReplayRejected(
    session,
    target_sequence,
    sender,
    receiver,
    plaintext,
    accepted_frame,
    target_material,
    forged_frame,
    ready_state,
    retained_state,
    full_state,
    consumed_state
  )) ==>
  inj-event(FailedReceiveAccepted(
    session,
    target_sequence,
    sender,
    receiver,
    plaintext,
    accepted_frame,
    target_material,
    forged_frame,
    ready_state,
    retained_state,
    full_state,
    consumed_state
  )).

(* The exact frame rejected at capacity is admitted only after the retained
   target was consumed.  Both correspondences preserve the same full state. *)
query session: bitstring,
      target_sequence: sequence,
      capacity_sequence: sequence,
      capacity_frame: bitstring,
      retained_state: bitstring,
      full_state: bitstring,
      consumed_state: bitstring,
      refilled_state: bitstring;
  inj-event(FailedReceiveAfterCapacityReleaseAdmitted(
    session,
    target_sequence,
    capacity_sequence,
    capacity_frame,
    retained_state,
    full_state,
    consumed_state,
    refilled_state
  )) ==>
  inj-event(FailedReceiveCapacityRejected(
    session,
    target_sequence,
    capacity_sequence,
    capacity_frame,
    retained_state,
    full_state
  )).

query session: bitstring,
      target_sequence: sequence,
      capacity_sequence: sequence,
      capacity_frame: bitstring,
      retained_state: bitstring,
      full_state: bitstring,
      consumed_state: bitstring,
      refilled_state: bitstring;
  inj-event(FailedReceiveAfterCapacityReleaseAdmitted(
    session,
    target_sequence,
    capacity_sequence,
    capacity_frame,
    retained_state,
    full_state,
    consumed_state,
    refilled_state
  )) ==>
  inj-event(FailedReceiveKeyConsumed(
    session,
    target_sequence,
    full_state,
    consumed_state
  )).

(* Before compromise, every successfully opened frame in this trace has one
   matching honest send with the same complete record label. *)
query session: bitstring,
      message_direction: direction,
      message_sequence: sequence,
      sender: key_id,
      receiver: key_id,
      plaintext: bitstring;
  inj-event(MessageReceived(
    session,
    message_direction,
    message_sequence,
    sender,
    receiver,
    plaintext
  )) ==>
  inj-event(MessageSent(
    session,
    message_direction,
    message_sequence,
    sender,
    receiver,
    plaintext
  )).
