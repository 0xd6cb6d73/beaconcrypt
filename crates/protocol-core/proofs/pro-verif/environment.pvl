  let sequence_51 = next_sequence(sequence_50) in
  let capacity_sequence = next_sequence(sequence_51) in
  let chain_1 = server_to_beacon_chain(root) in
  let chain_2 = ratchet_next(chain_1) in
  let chain_3 = ratchet_next(chain_2) in
  let chain_4 = ratchet_next(chain_3) in
  let chain_5 = ratchet_next(chain_4) in
  let chain_6 = ratchet_next(chain_5) in
  let chain_7 = ratchet_next(chain_6) in
