(* A single honest session with passive network observation.
   Removing replicated malicious endpoints avoids giving the transcript-only scenario autonomous active behavior.
   The two reachability queries ensure that the registration and record-delivery path completes. *)
process
  out(c, ed_public(SERVER_IDENTITY_SECRET));
  (
    HonestBeacon()
    | Server()
    | KeepBeaconStatePrivate()
  )
