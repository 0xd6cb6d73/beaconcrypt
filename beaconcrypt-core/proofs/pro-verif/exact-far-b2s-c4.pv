(* Exact literal far material; K_r=1. Scope and trace transfer: doc/impl/proverif-exact-far-material.md. *)
query s: bitstring, k: bitstring, kid: key_id, root: bitstring, t: nat;
  event(FsFarAccepted(beacon_to_server(), s, ed_public(k), kid, root, t)) ==> attacker(k).

process FsRecordsB2sMainAnyPin()
