+/-- Expose specialized scalar projections as bit-vector variables before `bv_decide`.
+Lean 4.34's symbolic reifier does not reduce the computed width of the generic
+scalar field projection. Generalization retains an equality to every original
+projection and is checked by the kernel like the ordinary `generalize` tactic. -/
+def generalizeScalarBvProjections : TacticM Unit := withMainContext do
+  let projections := #[``U8.bv, ``U16.bv, ``U32.bv, ``U64.bv, ``U128.bv, ``Usize.bv,
+    ``I8.bv, ``I16.bv, ``I32.bv, ``I64.bv, ``I128.bv, ``Isize.bv]
+  let mut types := #[(← (← getMainGoal).getType)]
+  let mut hypotheses := #[]
+  for decl in ← getLCtx do
+    if !decl.isImplementationDetail && (← isProp decl.type) then
+      types := types.push decl.type
+      hypotheses := hypotheses.push decl.fvarId
+  let (_, terms) ← (do
+    for type in types do
+      type.forEachWhere (fun expr => !expr.hasLooseBVars && expr.getAppNumArgs == 1 &&
+        match expr.getAppFn.constName? with
+        | some name => projections.contains name
+        | none => false) fun expr => do
+        modify (fun found : Array Expr => if found.contains expr then found else found.push expr)
+    : StateT (Array Expr) MetaM Unit).run #[]
+  unless terms.isEmpty do
+    let args ← terms.mapM fun expr => do
+      pure { expr, xName? := some (← mkFreshUserName `bv), hName? := some (← mkFreshUserName `hbv) : GeneralizeArg }
+    let (_, _, goal) ← (← getMainGoal).generalizeHyp args hypotheses
+    replaceMainGoal [goal]
+
