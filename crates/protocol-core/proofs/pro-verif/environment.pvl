let KeepFailedReceiveStatePrivate() =
  in(
    failed_receive_snapshots,
    (
      session: bitstring,
      target_sequence: sequence,
      retained_state: bitstring,
      full_state: bitstring,
      compromise_ack: channel
    )
  );
  out(compromise_ack, session).

(* Compromise occurs after both failed future opens and the neutral capacity
   rejection.  It publishes the exact 50 cached materials plus the live
   receive chain.  Consequently sequences two and three and the future
   sequence-52 ciphertext become readable, while the already-consumed
   sequence-one material remains unreachable. *)
let CompromiseFailedReceiveState() =
  in(
    failed_receive_snapshots,
    (
      session: bitstring,
      target_sequence: sequence,
      retained_state: bitstring,
      full_state: bitstring,
      compromise_ack: channel
    )
  );
  let failed_receive_state(
    full_sequence: sequence,
    live_receive_chain: bitstring,
    full_cache: failed_receive_cache
  ) = full_state in
  let failed_receive_cache_entry(
    cached_sequence_51: sequence,
    cached_material_51: bitstring,
    cache_tail_50: failed_receive_cache
  ) = full_cache in
  let failed_receive_cache_entry(
    cached_sequence_50: sequence,
    cached_material_50: bitstring,
    cache_tail_49: failed_receive_cache
  ) = cache_tail_50 in
  let failed_receive_cache_entry(
    cached_sequence_49: sequence,
    cached_material_49: bitstring,
    cache_tail_48: failed_receive_cache
  ) = cache_tail_49 in
