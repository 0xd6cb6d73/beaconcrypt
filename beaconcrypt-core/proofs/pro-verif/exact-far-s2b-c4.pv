(* Exact literal far material; K_r=1. Scope and trace transfer: doc/impl/proverif-exact-far-material.md. *)
query s: bitstring, b: bitstring, kid: key_id, root: bitstring, t: nat;
  event(FsFarAccepted(server_to_beacon(), s, b, kid, root, t)).

process FsRecordsS2bMain()
