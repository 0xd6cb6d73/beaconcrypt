  Result ratchet.control.ReceiveFinishWithRemoval
  := do
  let len_index ← lift (UScalar.cast .Usize state.receive_cache.len)
  let slot_index ← lift (UScalar.cast .Usize slot)
  let i ← ratchet.control.RECEIVE_CACHE_CAPACITY
