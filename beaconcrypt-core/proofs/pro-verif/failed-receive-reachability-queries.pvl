(* SPDX-License-Identifier: 0BSD *)

(* Every rejection and success phase must have a concrete trace; ProVerif reports the negation of each request, so the result gate requires all twelve to be false. *)
query session: bitstring, target_sequence: sequence, forged_frame: bitstring, entry_state: bitstring;
  event(ReceiveRejectedNeutral(session, target_sequence, forged_frame, entry_state)).

query session: bitstring, target_sequence: sequence, forged_frame: bitstring, entry_state: bitstring;
  event(ReceiveRejectionRetried(session, target_sequence, forged_frame, entry_state)).

query session: bitstring, target_sequence: sequence, sender: key_id, receiver: key_id, accepted_frame: bitstring, target_material: bitstring, forged_frame: bitstring, entry_state: bitstring, committed_state: bitstring;
  event(ReceiveFutureAccepted(session, target_sequence, sender, receiver, RECEIVE_TARGET_SECRET, accepted_frame, target_material, forged_frame, entry_state, committed_state)).

query session: bitstring, target_sequence: sequence, sender: key_id, receiver: key_id, accepted_frame: bitstring, target_material: bitstring, forged_frame: bitstring, entry_state: bitstring, committed_state: bitstring;
  event(ReceiveHonestFutureDelivered(session, target_sequence, sender, receiver, RECEIVE_TARGET_SECRET, accepted_frame, target_material, forged_frame, entry_state, committed_state)).

query session: bitstring, target_sequence: sequence, sender: key_id, receiver: key_id, accepted_frame: bitstring, target_material: bitstring, forged_frame: bitstring, entry_state: bitstring, committed_state: bitstring;
  event(ReceiveReplayRejected(session, target_sequence, sender, receiver, RECEIVE_TARGET_SECRET, accepted_frame, target_material, forged_frame, entry_state, committed_state)).

query session: bitstring, delayed_sequence: sequence, sender: key_id, receiver: key_id, delayed_frame: bitstring, delayed_material: bitstring, committed_state: bitstring, final_state: bitstring;
  event(ReceiveDelayedCachedAccepted(session, delayed_sequence, sender, receiver, RECEIVE_SKIPPED_SECRET, delayed_frame, delayed_material, committed_state, final_state)).

query session: bitstring, target_sequence: sequence, sender: key_id, receiver: key_id, accepted_frame: bitstring, target_material: bitstring, entry_state: bitstring, committed_state: bitstring;
  event(ReceiveMaximumGapAccepted(session, target_sequence, sender, receiver, RECEIVE_MAX_GAP_SECRET, accepted_frame, target_material, entry_state, committed_state)).

query session: bitstring, target_sequence: sequence, rejected_frame: bitstring, rejected_state: bitstring;
  event(ReceiveCapacityRejected(session, target_sequence, rejected_frame, rejected_state)).

query session: bitstring, cached_sequence: sequence, cached_material: bitstring, full_state: bitstring, released_state: bitstring;
  event(ReceiveCachedKeyConsumed(session, cached_sequence, cached_material, full_state, released_state)).

query session: bitstring, target_sequence: sequence, sender: key_id, receiver: key_id, accepted_frame: bitstring, target_material: bitstring, rejected_state: bitstring, released_state: bitstring, committed_state: bitstring;
  event(ReceiveAfterCapacityReleaseAccepted(session, target_sequence, sender, receiver, RECEIVE_AFTER_RELEASE_SECRET, accepted_frame, target_material, rejected_state, released_state, committed_state)).

(* The same private-state run includes fully attacker-controlled registered beacons, proving that isolation is active rather than assumed. *)
query server_identity: bitstring, beacon_identity: bitstring, init: beaconcrypt_core__pqxdh__t_InitKex, registration_id: beaconcrypt_core__pqxdh__t_RegistrationId, assigned_key_id: key_id, root_input: beaconcrypt_core__pqxdh__t_RootKeyInput, root: bitstring, associated_data: bitstring, session: bitstring, plaintext: bitstring;
  event(MaliciousRegistrationCommitted(server_identity, beacon_identity, init, registration_id, assigned_key_id, root_input, root, associated_data, session, plaintext)).

query attacker(MALICIOUS_TASK_SECRET).
