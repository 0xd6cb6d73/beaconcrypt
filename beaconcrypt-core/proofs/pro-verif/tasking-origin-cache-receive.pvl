(* Near-event comparison only: original far calls are evaluated by the public recipe projection, not executed in this worker. No full API equality claimed. *)
(* Exact-ID near worker with actual optional opening replies. *)
fun s2b_receive(bitstring,bitstring,bitstring):bitstring [data].
fun s2b_send(bitstring,bitstring,bool,bitstring,bool):bitstring [data].
fun s2b_reply(bitstring,bitstring):bitstring [data].
fun s2b_some(bitstring):bitstring [data].
fun s2b_none():bitstring [data].
event S2bPublished(direction,bitstring,bitstring,key_id,bitstring,nat,bitstring).
event S2bCachedAccepted(bitstring,bitstring,key_id,bitstring,bitstring).
def S2b_RECV_STEP(Cur,Next) {
let Cur(owner:bitstring,s:bitstring,b:bitstring,sender:key_id,kid:key_id,root:bitstring,ad:bitstring,m1:bitstring,m2:bitstring,far:bitstring,r:nat,cached:bool)=
 in(c,s2b_receive(=owner,call:bitstring,frame:bitstring));
 let crypto_frame(cipher:bitstring,tag:bitstring,commitment:bitstring,fs_seq(t:nat),=sender)=frame in (
 if t<=r then (
  if t=2 && cached then (let plaintext=open_frame(m1,ad,fs_seq(2),sender,frame) in (
 event S2bCachedAccepted(s,b,kid,root,plaintext); event FsReceived(server_to_beacon(),s,b,kid,root,2,plaintext); event FsReceivedFrame(server_to_beacon(),s,b,kid,root,2,frame); out(c,s2b_reply(call,s2b_some(plaintext))); Next(owner,s,b,sender,kid,root,ad,m1,m2,far,r,false)
 ) else (out(c,s2b_reply(call,s2b_none())); Next(owner,s,b,sender,kid,root,ad,m1,m2,far,r,cached))) else (out(c,s2b_reply(call,s2b_none())); Next(owner,s,b,sender,kid,root,ad,m1,m2,far,r,cached))
 ) else if t=2 then (let plaintext=open_frame(m1,ad,fs_seq(2),sender,frame) in (
 event FsReceived(server_to_beacon(),s,b,kid,root,2,plaintext); event FsReceivedFrame(server_to_beacon(),s,b,kid,root,2,frame); out(c,s2b_reply(call,s2b_some(plaintext))); Next(owner,s,b,sender,kid,root,ad,m1,m2,far,2,cached)
 ) else (out(c,s2b_reply(call,s2b_none())); Next(owner,s,b,sender,kid,root,ad,m1,m2,far,r,cached)))
 else if t=3 then (let plaintext=open_frame(m2,ad,fs_seq(3),sender,frame) in (
 event FsReceived(server_to_beacon(),s,b,kid,root,3,plaintext); event FsReceivedFrame(server_to_beacon(),s,b,kid,root,3,frame); out(c,s2b_reply(call,s2b_some(plaintext))); if r=1 then Next(owner,s,b,sender,kid,root,ad,m1,m2,far,3,true) else Next(owner,s,b,sender,kid,root,ad,m1,m2,far,3,cached)
 ) else (out(c,s2b_reply(call,s2b_none())); Next(owner,s,b,sender,kid,root,ad,m1,m2,far,r,cached)))
 else (out(c,s2b_reply(call,s2b_none())); Next(owner,s,b,sender,kid,root,ad,m1,m2,far,r,cached))
 ) else (out(c,s2b_reply(call,s2b_none())); Next(owner,s,b,sender,kid,root,ad,m1,m2,far,r,cached)).
}
let S2bRecvStop(owner:bitstring,s:bitstring,b:bitstring,sender:key_id,kid:key_id,root:bitstring,ad:bitstring,m1:bitstring,m2:bitstring,far:bitstring,r:nat,cached:bool)=0.
