          let entries ←
            Array.update state.receive_cache.entries slot_index i3
          let i4 ← lift (UScalar.cast .Usize last_slot)
          let entries1 ← Array.update entries i4 0#u64
          ok
            {
              state :=
                {
                  state
                    with
                    receive_cache := { entries := entries1, len := last_slot }
                },
              disposition := ratchet.control.ReceiveDisposition.Consumed,
              removal :=
                (core.option.Option.Some { target_slot := slot, last_slot })
            }
        else
          ok
            {
              state,
              disposition := ratchet.control.ReceiveDisposition.Retained,
              removal := core.option.Option.None
            }
      else
        ok
          {
            state,
            disposition := ratchet.control.ReceiveDisposition.Missing,
            removal := core.option.Option.None
