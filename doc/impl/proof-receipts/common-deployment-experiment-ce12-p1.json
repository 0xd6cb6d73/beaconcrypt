 "headlines": {
  "CE-KT": "ce_kt / ce_kt_close (per target, to CE's un-compiled ideal game I_g), ce_kt_sum_le / ce_kt_sum (exact sum over Fin qAccept x Fin qCreate), ce_kt_world / ce_kt_world_close / ce_kt_world_sum (record world with envGD); bill kemLoss + slotLoss; premises FunctionalDecapsulation, Phase1ReadBack, Phase2ReadBack, SourceFullCorrect, budget",
  "CE-OR": "ce_or_b2s <= sum_g (kemLoss + slotLoss + authLoss_g(dec_g and ISs_g) + publicationTerm B); ce_or_s2b adds beta_g with IS_g; per target ce_or_*_target; premises CE-KT plus KemBound, initBound, FrameReadBack (no DecoderAgreement since 6d13ef8b); b2s every Server raw receive (positions from 1), s2b every Beacon raw receive (positions from 2; position 1 is CE-A1, S2b-initial)",
  "CE-UKS": "ce_uks_b2s <= sum_g (kemLoss + slotLoss + authLoss_g(dec_g and ISs_g) + bindingTerm BI_g); ce_uks_sender adds beta_g with IS_g; per target ce_uks_*_target; premises CE-KT plus KemBound, initBound, FrameReadBack",
  "CE-APP": "mode P: ce_app <= sum_g (kemLoss + slotLoss + beta_g + recLoss_g(dec_g and IS_g) + 2^-min), min in bytes (FreshBounds.min; the frozen FreshGuessStatement charges one bit per byte), the sum carries qAccept*qCreate*2^-min; ce_app_server without beta_g (ISs_g); per target ce_app_*target; premises CE-KT plus KemBound, initBound",
  "CE-LOR": "mode P, every filter F (any function of the mode-P transcript view List (PublicEntry .P)): ofReal |Pr[win] - 1/2 Pr[eligible]| <= sum_g (kemLoss_W + slotLoss_W + recLoss_g(dec_g(W) and IS_g) + 1/2 (kemLoss_E + slotLoss_E + recLoss_g(dec_g(E) and IS_g)) + 1/2 beta_g) (ce_lor); ce_lor_server for PeerTests without beta_g; per target ce_lor_target, ce_lor_server_target; premises CE-KT plus KemBound, initBound",
  "anomaly": "ptc_bound: ctGuessByCca setup guess <= ofReal Adv^IND-CCA(ptc setup.kem guess) + ofReal correctnessError + 2^-256 (FunctionalDecapsulation); anomaly_beta; beta_decapsulations (phase 1 <= budget.finish + 1 decapsulations), ptc_post (phase 2 no query)"
 },
 "design_names_realized_as": {
  "chain_ideal / chain_ideal_close (C1-C3)": "PqxdhDeploymentHeadlineChain.chain_ideal, chain_ideal_close (= probe kt_le); C1-C2 chain_slot, chain_slot_close",
