(* Active strong-secrecy derivative of the maintained fs process.
   See doc/impl/proverif-active-strong-secrecy.md for the exact bounds,
   test eligibility and source-abstraction obligations. *)



fun fs_far_chain(bitstring, nat): bitstring.

def FS_S2B_RECV_STEP(Cur, Next) {
let Cur(
  server_identity: bitstring,
  beacon_identity: bitstring,
  assigned_key_id: key_id,
  root: bitstring,
  associated_data: bitstring,
  receive_material_2: bitstring,
  receive_material_3: bitstring,
  far_anchor: bitstring,
  r: nat,
  cached_2: bool
) =
  
  in(c, (call_label: bitstring, frame: bitstring)) ;

  let crypto_frame(
    frame_cipher: bitstring,
    frame_tag: bitstring,
    frame_commitment: bitstring,
    fs_seq(t: nat),
    =SERVER_KEY_ID
  ) = frame in
  (

    if t <= r then
    (

      if t = 2 && cached_2 then
      (

        let plaintext = open_frame(
          receive_material_2,
          associated_data,
          fs_seq(2),
          SERVER_KEY_ID,
          frame
        ) in
        (

          event FsReceived(
            server_to_beacon(),
            server_identity,
            beacon_identity,
            assigned_key_id,
            root,
            2,
            plaintext
          );
          event FsReceivedFrame(
            server_to_beacon(),
            server_identity,
            beacon_identity,
            assigned_key_id,
            root,
            2,
            frame
          );
 out(c,fs_strong_reply(call_label, frame, true));
          Next(
            server_identity,
            beacon_identity,
            assigned_key_id,
            root,
            associated_data,
            receive_material_2,
            receive_material_3,
            far_anchor,
            r,
            fs_s2b_cached_after_success(cached_2)
          )
        )
        else
        (

          event FsReceiveRejected(
            server_to_beacon(),
            server_identity,
            beacon_identity,
            assigned_key_id,
            root,
            t,
            frame
          );
 out(c,fs_strong_reply(call_label, frame, false));
          Next(
            server_identity,
            beacon_identity,
            assigned_key_id,
            root,
            associated_data,
            receive_material_2,
            receive_material_3,
            far_anchor,
            fs_s2b_failed_r(r, 2),
            fs_s2b_failed_cached_2(r, 2, cached_2)
          )
        )
      )
      else
      (
        event FsReceiveRejected(
          server_to_beacon(),
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          t,
          frame
        );
 out(c,fs_strong_reply(call_label, frame, false));
        Next(
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          associated_data,
          receive_material_2,
          receive_material_3,
          far_anchor,
          r,
          cached_2
        )
      )
    )
    else if t = 2 then
    (

      let plaintext = open_frame(
        receive_material_2,
        associated_data,
        fs_seq(2),
        SERVER_KEY_ID,
        frame
      ) in
      (
        
        event FsReceived(
          server_to_beacon(),
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          2,
          plaintext
        );
        event FsReceivedFrame(
          server_to_beacon(),
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          2,
          frame
        );
 out(c,fs_strong_reply(call_label, frame, true));
        Next(
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          associated_data,
          receive_material_2,
          receive_material_3,
          far_anchor,
          2,
          cached_2
        )
      )
      else
      (
        event FsReceiveRejected(
          server_to_beacon(),
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          t,
          frame
        );
 out(c,fs_strong_reply(call_label, frame, false));
        Next(
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          associated_data,
          receive_material_2,
          receive_material_3,
          far_anchor,
          fs_s2b_failed_r(r, 2),
          fs_s2b_failed_cached_2(r, 2, cached_2)
        )
      )
    )
    else if t = 3 then
    (
      
      let plaintext = open_frame(
        receive_material_3,
        associated_data,
        fs_seq(3),
        SERVER_KEY_ID,
        frame
      ) in
      (
        event FsReceived(
          server_to_beacon(),
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          3,
          plaintext
        );
        event FsReceivedFrame(
          server_to_beacon(),
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          3,
          frame
        );
 out(c,fs_strong_reply(call_label, frame, true));
        if r = 1 then
          Next(
            server_identity,
            beacon_identity,
            assigned_key_id,
            root,
            associated_data,
            receive_material_2,
            receive_material_3,
            far_anchor,
            3,
            true
          )
        else
          Next(
            server_identity,
            beacon_identity,
            assigned_key_id,
            root,
            associated_data,
            receive_material_2,
            receive_material_3,
            far_anchor,
            3,
            cached_2
          )
      )
      else
      (
        event FsReceiveRejected(
          server_to_beacon(),
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          t,
          frame
        );
 out(c,fs_strong_reply(call_label, frame, false));
        Next(
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          associated_data,
          receive_material_2,
          receive_material_3,
          far_anchor,
          fs_s2b_failed_r(r, 3),
          fs_s2b_failed_cached_2(r, 3, cached_2)
        )
      )
    )
    else
    (
      
      let plaintext = open_frame(
        ratchet_material(fs_far_chain(far_anchor, t)),
        associated_data,
        fs_seq(t),
        SERVER_KEY_ID,
        frame
      ) in
        event FsFarAccepted(
          server_to_beacon(),
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          t
        ); out(c,fs_strong_reply(call_label, frame, true))
 else out(c,fs_strong_reply(call_label, frame, false)); Next(
          server_identity,
          beacon_identity,
          assigned_key_id,
          root,
          associated_data,
          receive_material_2,
          receive_material_3,
          far_anchor,
          r,
          cached_2
        )
    )
  )
  else
    out(c,fs_strong_reply(call_label, frame, false));
    Next(
      server_identity,
      beacon_identity,
      assigned_key_id,
      root,
      associated_data,
      receive_material_2,
      receive_material_3,
      far_anchor,
      r,
      cached_2
    ).
}

let FsS2bRecvStop(
  server_identity: bitstring,
  beacon_identity: bitstring,
  assigned_key_id: key_id,
  root: bitstring,
  associated_data: bitstring,
  receive_material_2: bitstring,
  receive_material_3: bitstring,
  far_anchor: bitstring,
  r: nat,
  cached_2: bool
) = 0.
