(* fs-registration: how the session binds the Beacon identity.  The root
   input takes DH2 (ephemeral with the Beacon identity) in its second slot,
   and the associated data is built from the Server and Beacon identities.
   Exactly one of this file and the negative control fs-control-uks.pvl is
   loaded. *)
(* @beaconcrypt-fs-fidelity key=binding.root_input src=beaconcrypt-core/src/pqxdh.rs:391-405 anchor=let bytes: [u8; ROOT_KEY_INPUT_SIZE] = core::array::from_fn(|i| { *)
letfun fs_root_dh2(dh2: bitstring, dh3: bitstring) = dh2.

(* @beaconcrypt-fs-fidelity key=binding.associated_data src=beaconcrypt-core/src/pqxdh.rs:931-952 anchor=pub fn build_associated_data( *)
letfun fs_associated_data(server_identity: bitstring, beacon_identity: bitstring) =
  beaconcrypt_core__pqxdh__build_associated_data(server_identity, beacon_identity).
