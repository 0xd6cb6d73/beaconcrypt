let FailedReceiveScenario() =
  (
    StateNeutralFutureReceive()
    | StateNeutralCapacityReceive()
  ).

let KeepReceiveStatePrivate() =
  in(
    receive_snapshots,
    (
      session: bitstring,
      target_sequence: sequence,
      before_state: bitstring,
      after_state: bitstring,
      live_receive_chain: bitstring,
      live_cache: receive_cache,
      compromise_ack: channel
    )
  );
  out(compromise_ack, session).

(* The compromise branch discloses the unchanged live chain after rejection and no rejection-created cache material. *)
let CompromiseReceiveState() =
  in(
    receive_snapshots,
    (
      session: bitstring,
      target_sequence: sequence,
      before_state: bitstring,
      after_state: bitstring,
      live_receive_chain: bitstring,
      live_cache: receive_cache,
      compromise_ack: channel
    )
  );
  let receive_cache_empty() = live_cache in
  event ReceiveStateCompromised(
    session,
    target_sequence,
    before_state,
    after_state
  );
  out(c, live_receive_chain);
  out(compromise_ack, session).
