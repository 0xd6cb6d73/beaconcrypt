(**************************************************************************)
(* Reviewed symbolic primitive boundary                                   *)
(**************************************************************************)

(* Rust uses u64 identifiers and counters.  Fresh values of these private
   sorts model the checked, collision-free prefix of those finite spaces. *)
type key_id.
type sequence.
type direction.
type role.

fun first_sequence(): sequence [data].
fun next_sequence(sequence): sequence [data].
fun server_to_beacon(): direction [data].
fun beacon_to_server(): direction [data].
fun beacon_role(): role [data].
fun server_role(): role [data].

(* Fixed-width LE64 encoding is injective on the modeled key-ID sort. *)
fun key_id_encoding(key_id): bitstring [data].

(* Disjoint production key encodings.  The two X25519 constructors represent
   [4:u8, 128:u8, key] for a prekey and [4:u8, 129:u8, key] for a one-time
   key. Rust reserves low marker bytes for types and high marker bytes for
   roles, and the F* lemmas check the concrete values and byte positions. *)
fun tag_ed25519(bitstring): bitstring [data].
fun tag_x25519_prekey(bitstring): bitstring [data].
fun tag_x25519_one_time(bitstring): bitstring [data].
fun tag_mlkem768(bitstring): bitstring [data].

(* Ed25519 and its authenticated verification equation. *)
fun ed_public(bitstring): bitstring.
fun sign(bitstring, bitstring): bitstring.
reduc forall message: bitstring, signing_key: bitstring;
  verify_signature(sign(message, signing_key), ed_public(signing_key)) = message.

(* X25519.  Identity-key conversion is represented by using the same secret
   name below ed_public and x25519_public. *)
fun x25519_public(bitstring): bitstring.
reduc forall identity_secret: bitstring;
  x25519_public_from_ed(ed_public(identity_secret)) =
  x25519_public(identity_secret).
fun x25519_shared(bitstring, bitstring): bitstring [private].
reduc forall server_secret: bitstring, beacon_secret: bitstring;
  x25519_server_dh(server_secret, x25519_public(beacon_secret)) =
  x25519_shared(server_secret, beacon_secret).
reduc forall beacon_secret: bitstring, server_secret: bitstring;
  x25519_beacon_dh(beacon_secret, x25519_public(server_secret)) =
  x25519_shared(server_secret, beacon_secret).

(* ML-KEM encapsulation/decapsulation correctness.  The encapsulator knows
   both the ciphertext and shared secret for its fresh coins. *)
fun mlkem_public(bitstring): bitstring.
fun mlkem_ciphertext(bitstring, bitstring): bitstring.
fun mlkem_shared_secret(bitstring, bitstring): bitstring.
reduc forall secret_key: bitstring, coins: bitstring;
  mlkem_decapsulate(
    mlkem_ciphertext(mlkem_public(secret_key), coins),
    secret_key
  ) = mlkem_shared_secret(mlkem_public(secret_key), coins).

(* These constructors are referenced by the backend replacements attached to
   production Rust functions.  Their argument order is the Stage 6 layout:
   registration ID = identity || one-time key, and root input =
   0xff^32 || DH1 || DH2 || DH3 || DH4 || KEM secret.  The fixed padding is
   an explicit first field rather than an erased comment-only convention. *)
fun registration_identifier(bitstring, bitstring): bitstring [data].
fun pqxdh_ff32_padding(): bitstring [data].
fun pqxdh_root_input(
  bitstring,
  bitstring,
  bitstring,
  bitstring,
  bitstring,
  bitstring
): bitstring [data].

(* Production uses exactly two HKDF-SHA-512 domains, both without salt:
   "BeaconcryptPqxdh_CURVE25519_SHA-512_ML-KEM-768" (46 bytes) and
   "SymRatchet_HKDF_SHA-512_CHACHA20_POLY1305" (41 bytes).  A single public
   one-way stream constructor models HKDF under those domains.  Its shared
   projections make the first 64 bytes of the 76-byte per-record expansion
   definitionally identical to the 64-byte initialization expansion when the
   input is equal; output length is not modeled as a domain separator. *)
type kdf_domain.
type hkdf_stream.

fun pqxdh_domain(): kdf_domain [data].
fun symmetric_ratchet_domain(): kdf_domain [data].
fun hkdf_sha512_no_salt(bitstring, kdf_domain): hkdf_stream.
fun hkdf_first_32(hkdf_stream): bitstring.
fun hkdf_second_32(hkdf_stream): bitstring.
fun hkdf_final_12(hkdf_stream): bitstring.

(* Stored record material contains only the projected key and nonce.  It does
   not retain the HKDF stream, so disclosing cached material cannot reveal the
   second projection that becomes the next chain. *)
fun ratchet_key_nonce(bitstring, bitstring): bitstring.
reduc forall key: bitstring, nonce: bitstring;
  material_key(ratchet_key_nonce(key, nonce)) = key.
reduc forall key: bitstring, nonce: bitstring;
  material_nonce(ratchet_key_nonce(key, nonce)) = nonce.

letfun pqxdh_root(input: bitstring) =
  hkdf_first_32(hkdf_sha512_no_salt(input, pqxdh_domain())).

(* The server sends on the first initialization projection and receives on the
   second; the beacon reverses those roles at its existing call sites. *)
letfun server_to_beacon_chain(root: bitstring) =
  hkdf_first_32(
    hkdf_sha512_no_salt(root, symmetric_ratchet_domain())
  ).

letfun beacon_to_server_chain(root: bitstring) =
  hkdf_second_32(
    hkdf_sha512_no_salt(root, symmetric_ratchet_domain())
  ).

letfun ratchet_next(chain: bitstring) =
  hkdf_second_32(
    hkdf_sha512_no_salt(chain, symmetric_ratchet_domain())
  ).

letfun ratchet_material(chain: bitstring) =
  ratchet_key_nonce(
    hkdf_first_32(
      hkdf_sha512_no_salt(chain, symmetric_ratchet_domain())
    ),
    hkdf_final_12(
      hkdf_sha512_no_salt(chain, symmetric_ratchet_domain())
    )
  ).

(* Ideal ChaCha20-Poly1305 plus the CTX commitment.  The only opening
   reduction below requires the same key material, ordered AD, sequence, and
   sender ID.  `ctx_commitment` deliberately models the fixed-size BLAKE2b
   use as a collision-free symbolic constructor; this is a symbolic primitive
   assumption, not a computational proof of BLAKE2b. *)
fun aead_cipher(
  bitstring,
  bitstring,
  bitstring,
  bitstring
): bitstring.
fun aead_tag(
  bitstring,
  bitstring,
  bitstring,
  bitstring
): bitstring.
fun ctx_commitment(
  bitstring,
  bitstring,
  bitstring,
  bitstring,
  sequence,
  key_id
): bitstring.
fun crypto_frame(
  bitstring,
  bitstring,
  bitstring,
  sequence,
  key_id
): bitstring [data].

letfun seal_frame(
  material: bitstring,
  associated_data: bitstring,
  message_sequence: sequence,
  sender_id: key_id,
  plaintext: bitstring
) =
  crypto_frame(
    aead_cipher(
      material_key(material),
      material_nonce(material),
      associated_data,
      plaintext
    ),
    aead_tag(
      material_key(material),
      material_nonce(material),
      associated_data,
      plaintext
    ),
    ctx_commitment(
      material_key(material),
      material_nonce(material),
      associated_data,
      aead_tag(
        material_key(material),
        material_nonce(material),
        associated_data,
        plaintext
      ),
      message_sequence,
      sender_id
    ),
    message_sequence,
    sender_id
  ).

reduc forall key: bitstring,
             nonce: bitstring,
             associated_data: bitstring,
             message_sequence: sequence,
             sender_id: key_id,
             plaintext: bitstring;
  open_frame(
    ratchet_key_nonce(key, nonce),
    associated_data,
    message_sequence,
    sender_id,
    crypto_frame(
      aead_cipher(
        key,
        nonce,
        associated_data,
        plaintext
      ),
      aead_tag(
        key,
        nonce,
        associated_data,
        plaintext
      ),
      ctx_commitment(
        key,
        nonce,
        associated_data,
        aead_tag(
          key,
          nonce,
          associated_data,
          plaintext
        ),
        message_sequence,
        sender_id
      ),
      message_sequence,
      sender_id
    )
  ) = plaintext.
