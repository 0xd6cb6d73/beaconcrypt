  else if target = next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(first_sequence()))))))))))))))))))))))))))))))))))))))))))))))))) then general_prefix_50(chain)
  else if target = next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(next_sequence(first_sequence())))))))))))))))))))))))))))))))))))))))))))))))))) then general_prefix_51(chain).

(* One token per admitted server owner; publication precedes the next request. *)
let GeneralAdmissionSend() =
  in(general_send_states, (agreement: authenticated_registration_session_t,
    associated_data: bitstring, assigned: key_id, target: sequence,
    chain: bitstring, prior_material: receive_cache, send_peer_chain: bitstring)) [precise];
  in(c, application: bitstring);
  let material = ratchet_material(chain) in
  let frame = seal_frame(material, associated_data, target, SERVER_KEY_ID, application) in
  event GeneralAdmissionRecordOrigin(agreement, target, application, frame, assigned) [];
  event GeneralAdmissionPlanOrigin(agreement, target, send_peer_chain,
    ratchet_next(chain), prior_material, material) [];
  out(c, frame);
  out(general_send_states, (agreement, associated_data, assigned, next_sequence(target),
    ratchet_next(chain), receive_cache_entry(target, material, prior_material), send_peer_chain)).

let GeneralAdmissionBeacon(main_beacon_record_secret: bitstring, general_expected_sequence: sequence, general_continue: bool) =
  new main_beacon_identity_secret: bitstring;
  new main_beacon_prekey_secret: bitstring;
  new main_beacon_one_time_secret: bitstring;
  new main_beacon_pq_secret: bitstring;
  let main_server_identity = ed_public(SERVER_IDENTITY_SECRET) in
  let main_beacon_identity = ed_public(main_beacon_identity_secret) in
  let main_beacon_prekey = x25519_public(main_beacon_prekey_secret) in
  let main_beacon_one_time = x25519_public(main_beacon_one_time_secret) in
  let main_beacon_pq = mlkem_public(main_beacon_pq_secret) in
  let main_core_init = beaconcrypt_core__pqxdh__InitKex(
    tag_ed25519(main_beacon_identity),
    tag_x25519_prekey(main_beacon_prekey),
    tag_x25519_one_time(main_beacon_one_time),
    tag_mlkem768(main_beacon_pq)
  ) in
  let main_verified_init = beaconcrypt_core__pqxdh__VerifiedInitKex(
    main_beacon_identity,
    main_beacon_prekey,
    main_beacon_one_time,
    main_beacon_pq
  ) in
  let main_registration_id =
    beaconcrypt_core__pqxdh__registration_id(main_verified_init)
  in
  new main_registration_session: bitstring;
  event BeaconInitiated(
    main_server_identity,
    main_beacon_identity,
    main_core_init,
    main_registration_id,
    main_registration_session
  );
  let main_initiated_bundle = authenticated_init_bundle(
    main_server_identity,
    main_beacon_identity,
    main_core_init,
    main_registration_id,
    main_beacon_prekey,
    main_beacon_one_time,
    main_beacon_pq,
    main_registration_session
  ) in
  event BeaconBundleInitiated(main_initiated_bundle);
  insert honest_origin(main_beacon_identity, main_registration_session);
  (
  RegistrationReplayGuard(
    main_server_identity,
    main_beacon_identity,
    main_registration_session
  )
  |
  out(
    c,
    signed_init_kex(
      tag_ed25519(main_beacon_identity),
      sign(tag_x25519_prekey(main_beacon_prekey), main_beacon_identity_secret),
      sign(tag_x25519_one_time(main_beacon_one_time), main_beacon_identity_secret),
      sign(tag_mlkem768(main_beacon_pq), main_beacon_identity_secret)
    )
  );
  out(c, registration_continue(main_registration_id));
  in(c, main_response: bitstring);
  let kex_response(
    main_response_server_identity,
    main_server_ephemeral,
    main_kem_ciphertext,
    main_initial_frame,
    main_assigned_key_id
  ) = main_response in
  if main_response_server_identity = main_server_identity then
    let main_dh1 = x25519_beacon_dh(
      main_beacon_prekey_secret,
      x25519_public(SERVER_IDENTITY_SECRET)
    ) in
    let main_dh2 = x25519_beacon_dh(main_beacon_identity_secret, main_server_ephemeral) in
    let main_dh3 = x25519_beacon_dh(main_beacon_prekey_secret, main_server_ephemeral) in
    let main_dh4 = x25519_beacon_dh(main_beacon_one_time_secret, main_server_ephemeral) in
    let main_kem_secret = mlkem_decapsulate(main_kem_ciphertext, main_beacon_pq_secret) in
    let main_shared_secrets = beaconcrypt_core__pqxdh__PqxdhSharedSecrets(
      main_dh1,
      main_dh2,
      main_dh3,
      main_dh4,
      main_kem_secret
    ) in
    let main_root_input =
      beaconcrypt_core__pqxdh__build_root_key_input(main_shared_secrets)
    in
    let main_root = pqxdh_root(
      beaconcrypt_core__pqxdh__t_RootKeyInput_to_bitstring(main_root_input)
    ) in
    let main_associated_data =
      beaconcrypt_core__pqxdh__build_associated_data(
        main_server_identity,
        main_beacon_identity
      )
    in
    let main_session = session_label(
      main_server_identity,
      main_beacon_identity,
      main_assigned_key_id,
      main_root
    ) in
    let crypto_frame(general_cipher, general_tag, general_commitment,
      general_sequence, =SERVER_KEY_ID) = main_initial_frame in
    if general_sequence = general_expected_sequence then
    let general_plan(general_target_material, general_next_chain, general_cache) =
      general_initial_plan(general_expected_sequence, server_to_beacon_chain(main_root)) in
    let main_opened_initial = open_frame(general_target_material,
      main_associated_data, general_sequence, SERVER_KEY_ID, main_initial_frame) in
    if general_sequence = first_sequence() then
    let main_expected_binding = beaconcrypt_core__pqxdh__RegistrationKeyIdBinding(
      key_id_encoding(main_assigned_key_id)
    ) in
    let registration_payload(=main_expected_binding, general_nonempty(main_initial_plaintext)) = main_opened_initial in
    let main_beacon_establishment = establishment_transcript(
      main_server_identity, main_beacon_identity, main_core_init, main_registration_id,
      main_beacon_prekey, main_beacon_one_time, main_beacon_pq, main_server_ephemeral,
      main_kem_ciphertext, main_initial_frame, main_response, main_root_input, main_root,
      main_associated_data, main_assigned_key_id, SERVER_KEY_ID, main_session,
      main_registration_session
    ) in
    event GeneralAdmissionCompleted(establishment_authenticated_session(main_beacon_establishment),
      general_sequence, main_opened_initial, main_initial_frame, main_response,
      main_assigned_key_id);
    event GeneralAdmissionPoststate(establishment_authenticated_session(main_beacon_establishment),
      general_sequence, beacon_to_server_chain(main_root),
      general_next_chain, general_cache, general_target_material) [];
    (* Private state handoff is uniform across every admitted sequence. *)
    (out(general_admitted_states, (establishment_authenticated_session(main_beacon_establishment),
      main_associated_data, main_assigned_key_id,
      receive_state(general_sequence, general_next_chain, general_cache),
      beacon_to_server_chain(main_root)))
    | (if general_continue then GeneralAdmissionContinue(establishment_authenticated_session(main_beacon_establishment)))
    | if main_assigned_key_id = SERVER_KEY_ID then
      event GeneralAdmissionRelabelled(general_sequence, main_opened_initial))
  ).

let GeneralAdmissionServer(
  main_initial_secret: bitstring,
  main_cached_secret: bitstring,
  main_advance_secret: bitstring,
  main_future_secret: bitstring
) =
  in(c, main_incoming_init: bitstring);
  let signed_init_kex(
    main_encoded_identity,
    main_signed_prekey,
    main_signed_one_time,
    main_signed_pq
  ) = main_incoming_init in
  let tag_ed25519(main_beacon_identity: bitstring) = main_encoded_identity in
  let tag_x25519_prekey(main_beacon_prekey: bitstring) =
    verify_signature(main_signed_prekey, main_beacon_identity)
  in
  let tag_x25519_one_time(main_beacon_one_time: bitstring) =
    verify_signature(main_signed_one_time, main_beacon_identity)
  in
  let tag_mlkem768(main_beacon_pq: bitstring) =
    verify_signature(main_signed_pq, main_beacon_identity)
  in
  let main_core_init = beaconcrypt_core__pqxdh__InitKex(
    main_encoded_identity,
    tag_x25519_prekey(main_beacon_prekey),
    tag_x25519_one_time(main_beacon_one_time),
    tag_mlkem768(main_beacon_pq)
  ) in
  let main_verified_init = beaconcrypt_core__pqxdh__VerifiedInitKex(
    main_beacon_identity,
    main_beacon_prekey,
    main_beacon_one_time,
    main_beacon_pq
  ) in
  let main_registration_id =
    beaconcrypt_core__pqxdh__registration_id(main_verified_init)
  in
  (* Honest agreement and replay events are scoped to an uncompromised
     identity.  Attacker-owned identities use MaliciousServer below. *)
  get honest_origin(=main_beacon_identity, main_registration_session: bitstring) in
  new main_server_ephemeral_secret: bitstring;
  new main_kem_coins: bitstring;
  let main_server_ephemeral = x25519_public(main_server_ephemeral_secret) in
  let main_kem_ciphertext = mlkem_ciphertext(main_beacon_pq, main_kem_coins) in
  let main_kem_secret = mlkem_shared_secret(main_beacon_pq, main_kem_coins) in
  let main_dh1 = x25519_server_dh(SERVER_IDENTITY_SECRET, main_beacon_prekey) in
  let main_dh2 = x25519_server_dh(
    main_server_ephemeral_secret,
    x25519_public_from_ed(main_beacon_identity)
  ) in
  let main_dh3 = x25519_server_dh(main_server_ephemeral_secret, main_beacon_prekey) in
  let main_dh4 = x25519_server_dh(main_server_ephemeral_secret, main_beacon_one_time) in
  let main_shared_secrets = beaconcrypt_core__pqxdh__PqxdhSharedSecrets(
    main_dh1,
    main_dh2,
    main_dh3,
    main_dh4,
    main_kem_secret
  ) in
  let main_root_input =
    beaconcrypt_core__pqxdh__build_root_key_input(main_shared_secrets)
  in
  let main_root = pqxdh_root(
    beaconcrypt_core__pqxdh__t_RootKeyInput_to_bitstring(main_root_input)
  ) in
  let main_server_identity = ed_public(SERVER_IDENTITY_SECRET) in

  (* A private one-owner process performs the atomic Fresh -> Consumed
     transition and answers Consumed forever after, including after abort. *)
  new main_replay_reply: channel;
  out(
    replay_requests,
    (main_beacon_identity, main_core_init, main_registration_id, main_replay_reply)
  );
  in(main_replay_reply, main_replay_result: replay_status);
  if main_replay_result = replay_fresh() then
  (
    event ServerAccepted(
      main_server_identity,
      main_beacon_identity,
      main_core_init,
      main_registration_id,
      main_root_input,
      main_root,
      main_registration_session
    );
    let main_accepted_bundle = authenticated_init_bundle(
      main_server_identity,
      main_beacon_identity,
      main_core_init,
      main_registration_id,
      main_beacon_prekey,
      main_beacon_one_time,
      main_beacon_pq,
      main_registration_session
    ) in
    event ServerBundleAccepted(main_accepted_bundle);

    (* Replay state remains consumed even on this modeled main_response failure. *)
    in(c, main_registration_control: bitstring);
    if main_registration_control = registration_abort(main_registration_id) then
      event ServerResponseAborted(
        main_server_identity,
        main_beacon_identity,
        main_core_init,
        main_registration_id,
        main_root_input,
        main_root,
        main_registration_session
      )
    else
      let registration_continue(=main_registration_id) = main_registration_control in
      new main_assigned_key_id: key_id;
      let main_associated_data =
        beaconcrypt_core__pqxdh__build_associated_data(
          main_server_identity,
          main_beacon_identity
        )
      in
      let main_session = session_label(
        main_server_identity,
        main_beacon_identity,
        main_assigned_key_id,
        main_root
      ) in
      let main_server_chain_1 = server_to_beacon_chain(main_root) in
      let main_server_material_1 = ratchet_material(main_server_chain_1) in
      let main_binding =
        beaconcrypt_core__pqxdh__RegistrationKeyIdBinding(
          key_id_encoding(main_assigned_key_id)
        )
      in
      let main_initial_frame = seal_frame(
        main_server_material_1,
        main_associated_data,
        first_sequence(),
        SERVER_KEY_ID,
        registration_payload(main_binding, general_nonempty(main_initial_secret))
      ) in
      let main_response = kex_response(
        main_server_identity,
        main_server_ephemeral,
        main_kem_ciphertext,
        main_initial_frame,
        main_assigned_key_id
      ) in
      event MessageSent(
        main_session,
        server_to_beacon(),
        first_sequence(),
        SERVER_KEY_ID,
        main_assigned_key_id,
        main_initial_secret
      );
      event MessageKeyUnavailable(
        main_session,
        server_role(),
        server_to_beacon(),
        first_sequence(),
        main_server_material_1
      );
      let main_server_establishment = establishment_transcript(
        main_server_identity,
        main_beacon_identity,
        main_core_init,
        main_registration_id,
        main_beacon_prekey,
        main_beacon_one_time,
        main_beacon_pq,
        main_server_ephemeral,
        main_kem_ciphertext,
        main_initial_frame,
        main_response,
        main_root_input,
        main_root,
        main_associated_data,
        main_assigned_key_id,
        SERVER_KEY_ID,
        main_session,
        main_registration_session
      ) in
      event ServerCommitted(main_server_establishment);
      event ServerRegistrationSessionCommitted(establishment_session(main_server_establishment), main_assigned_key_id);
      event GeneralAdmissionSessionOrigin(establishment_authenticated_session(main_server_establishment), main_assigned_key_id) [];
      event RegistrationRecordSent(
        establishment_session(main_server_establishment),
        first_sequence(),
        registration_payload(main_binding, general_nonempty(main_initial_secret)),
        main_initial_frame
      , main_assigned_key_id);
      event GeneralAdmissionRecordOrigin(establishment_authenticated_session(main_server_establishment), first_sequence(), registration_payload(main_binding, general_nonempty(main_initial_secret)), main_initial_frame, main_assigned_key_id) [];
      let general_expected_cache_1 = receive_cache_empty() in
      event GeneralAdmissionPlanOrigin(establishment_authenticated_session(main_server_establishment),
        first_sequence(), beacon_to_server_chain(main_root), ratchet_next(main_server_chain_1),
        general_expected_cache_1, main_server_material_1) [];
      out(c, main_response);

      out(general_send_states, (
        establishment_authenticated_session(main_server_establishment),
        main_associated_data, main_assigned_key_id, next_sequence(first_sequence()),
        ratchet_next(main_server_chain_1),
        receive_cache_entry(first_sequence(), main_server_material_1, general_expected_cache_1),
        beacon_to_server_chain(main_root)))
  )
  else
    event RegistrationReplayRejected(
      main_server_identity,
      main_beacon_identity,
      main_core_init,
      main_registration_id,
      main_registration_session
    ).
