import BeaconcryptCore.AdapterRecordExtraction.Funs
import BeaconcryptCore.Computational.RecordEffectsReceiveBridge
import BeaconcryptCore.PanicFreedom.RecordEffects

/-! The actual Rust `execute_record_receive` is generated by Charon/Aeneas in `AdapterRecordExtraction`, including its loop and output closure. This module proves its equality with the maintained request program under explicit deterministic native-style replies, then composes that equality with the existing core/model bridge. Optional hash and AEAD failure and the full returned kernel are retained. The native primitive implementations, physical erasure, native parser and probabilistic primitive-state interpretation remain explicit boundaries. -/

open CoreModels Aeneas
open Aeneas.Std hiding namespace core alloc
open RustM beaconcrypt_core

set_option autoImplicit false
set_option warningAsError true

namespace BeaconcryptCore.Refinement.AdapterRecordReceive

open OracleComp OracleSpec
open BeaconcryptCore.Computational
open beaconcrypt.ratchet

/-- Deterministic primitive replies with the same optional failure interface as the native wrappers. -/
structure Replies where
  kdf : ratchet.SymmetricRatchetKdfRequest → ratchet.RatchetKdfResponse
  hash : Pqxdh.Bytes → Option (Array Std.U8 64#usize)
  aead : RawCtxSourceOpen.BaseInput → Option (alloc.vec.Vec Std.U8)

/-- A primitive interpretation erases the borrowed copy on every hash outcome. -/
@[instance_reducible] def operations (replies : Replies) (erased : Array Std.U8 227#usize) : Operations where
  kdf request := ok (replies.kdf request)
  hash transcript := ok (replies.hash (PqxdhRefinement.absBytes transcript.bytes), { bytes := erased })
  aead request := ok (request.bind fun request => replies.aead (RecordEffectsReceiveProgram.aeadQuery request))
  compare left right := ok (decide (left.val.map PqxdhRefinement.absByte =
    right.val.map PqxdhRefinement.absByte))

def implementation (replies : Replies) : QueryImpl RawCtxSourceOpen.NativeSpec Id
  | .inl request => replies.kdf request
  | .inr (.inl bytes) => Option.map (fun bytes => PqxdhRefinement.absBytes bytes) (replies.hash bytes)
  | .inr (.inr request) => Option.map (fun bytes => bytes.val.map PqxdhRefinement.absByte) (replies.aead request)

def decodeResult
    (result : ratchet.concrete.ConcreteRatchetKernel × Option beaconcrypt.shared.Decrypted) :
    RecordEffectsReceiveProgram.Result :=
  (result.1, result.2.map fun opened => ⟨opened.plaintext.val.map PqxdhRefinement.absByte, opened.key_id, opened.seq⟩)

/-- The generated Rust loop forwards the exact next phase or the exact terminal result. -/
theorem receiver_unfold [Operations] (effect : record_effects.RecordReceiveEffect) :
    beaconcrypt.ratchet.execute_record_receive effect =
      match beaconcrypt.ratchet.execute_record_receive_loop.body effect with
      | .ok (.cont next) => beaconcrypt.ratchet.execute_record_receive next
      | .ok (.done result) => .ok result
      | .fail error => .fail error
      | .div => .div := by
  rw [beaconcrypt.ratchet.execute_record_receive, beaconcrypt.ratchet.execute_record_receive_loop,
    loop.eq_def]
  cases beaconcrypt.ratchet.execute_record_receive_loop.body effect with
  | ok control => cases control <;> rfl
  | fail => rfl
  | div => rfl

theorem rust_map_eq_bind {X Y : Type} (f : X → Y) (value : RustM X) :
    f <$> value = (do let result ← value; ok (f result)) := by
  cases value <;> rfl

theorem mapReply_eq_map {X Y : Type} (f : X → Y) (value : Option X) :
    RawCtxOwnerResult.mapReply f value = Option.map f value := by
  cases value <;> rfl

def abstractOpened (opened : record.OpenedRecord (alloc.vec.Vec Std.U8)) :
    record.OpenedRecord Pqxdh.Bytes :=
  ⟨opened.plaintext.val.map PqxdhRefinement.absByte, opened.key_id, opened.seq⟩

/-- Adapting the returned plaintext preserves the entire core's success or rollback state. -/
theorem finish_bytes (pending : record_effects.RecordReceiveAead)
    (plaintext : Option (alloc.vec.Vec Std.U8)) :
    (fun result => (result.1, Option.map abstractOpened result.2)) <$> pending.finish plaintext =
      pending.finish (plaintext.map fun bytes => bytes.val.map PqxdhRefinement.absByte) := by
  cases plaintext with
  | none => rfl
  | some bytes =>
      simp only [record_effects.RecordReceiveAead.finish, record.OpenAead.finish,
        ratchet.concrete.ReceiveOpen.impl.context, ratchet.concrete.ReceiveOpen.sequence,
        bind_tc_ok, Option.map_some]
      cases preparedEq : pending.pending.opening.prepared with
      | PreparedReceiveCachedCase cached =>
          simp only [bind_tc_ok]
          simpa only [rust_map_eq_bind, mapReply_eq_map, Option.map_some, abstractOpened] using
            (RawCtxOwnerResult.finish_map pending.pending.opening
            (.Some ⟨bytes, pending.pending.opening.context.sender_kid, cached.sequence⟩) abstractOpened).symm
      | PreparedReceiveFutureCase future =>
          simp only [bind_tc_ok]
          simpa only [rust_map_eq_bind, mapReply_eq_map, Option.map_some, abstractOpened] using
            (RawCtxOwnerResult.finish_map pending.pending.opening
            (.Some ⟨bytes, pending.pending.opening.context.sender_kid, future.target_sequence⟩) abstractOpened).symm

def publicOpened (opened : record.OpenedRecord (alloc.vec.Vec Std.U8)) : beaconcrypt.shared.Decrypted :=
  ⟨opened.plaintext, opened.key_id, opened.seq⟩

/-- The generated output closure copies exactly plaintext, sender and sequence. -/
theorem output_map (reply : Option (record.OpenedRecord (alloc.vec.Vec Std.U8))) :
    core.option.Option.map
      beaconcrypt.ratchet.execute_record_receive.closure.Insts.CoreOpsFunctionFnOnceTupleOpenedRecordVecU8Decrypted
      reply () = ok (Option.map publicOpened reply) := by
  cases reply <;> rfl

theorem receiver_aead (replies : Replies) (erased : Array Std.U8 227#usize)
    (pending : record_effects.RecordReceiveAead) :
    decodeResult <$> @beaconcrypt.ratchet.execute_record_receive (operations replies erased)
      (.AeadRequested pending) =
      simulateQ (implementation replies) (RecordEffectsReceiveProgram.execute erased (.AeadRequested pending)) := by
  let inst : Operations := operations replies erased
  obtain ⟨request, requested⟩ := BeaconcryptCore.PanicFreedom.RecordEffects.RecordReceiveAead_request_total pending
  rw [receiver_unfold]
  simp only [beaconcrypt.ratchet.execute_record_receive_loop.body, requested,
    execute_open_request, bind_tc_ok]
  have openedEq : @Operations.aead (operations replies erased) request =
      ok (request.bind fun request => replies.aead (RecordEffectsReceiveProgram.aeadQuery request)) := rfl
  rw [openedEq]
  simp only [bind_tc_ok]
  obtain ⟨result, finished⟩ := BeaconcryptCore.PanicFreedom.RecordEffects.RecordReceiveAead_finish_total pending
    (request.bind fun request => replies.aead (RecordEffectsReceiveProgram.aeadQuery request))
  rcases result with ⟨kernel, opened⟩
  rw [finished]
  simp only [bind_tc_ok, output_map]
  change ok (decodeResult (kernel, Option.map publicOpened opened)) = _
  have finishedBytes : pending.finish
      (Option.map (fun bytes => bytes.val.map PqxdhRefinement.absByte)
        (request.bind fun request => replies.aead (RecordEffectsReceiveProgram.aeadQuery request))) =
      ok (kernel, Option.map abstractOpened opened) := by
    rw [← finish_bytes, finished]
    rfl
  rw [RecordEffectsReceiveProgram.execute, ← QueryImpl.simulateQ_compose]
  simp only [RecordEffectsReceiveProgram.executeAead, requested,
    RawCtxInterpretedOpening.bindResult]
  cases request with
  | none =>
      simp only [Option.bind_none, Option.map_none] at finishedBytes
      simp only [pure_bind, finishedBytes, simulateQ_pure]
      cases opened <;> rfl
  | some request =>
      simp only [simulateQ_bind, simulateQ_spec_query, QueryImpl.apply_compose,
        RawCtxSourceOpen.openLift, implementation]
      change _ = simulateQ (implementation replies ∘ₛ RawCtxSourceOpen.openLift)
        (RawCtxInterpretedOpening.bindResult
          (pending.finish (Option.map (fun bytes => bytes.val.map PqxdhRefinement.absByte)
            (replies.aead (RecordEffectsReceiveProgram.aeadQuery request))))
          (fun result => pure (ok (result.1,
            RawCtxOwnerResult.mapReply RecordEffectsReceiveProgram.decryptedOf result.2))))
      simp only [Option.bind_some] at finishedBytes
      simp only [finishedBytes, RawCtxInterpretedOpening.bindResult, simulateQ_pure]
      cases opened <;> rfl

def afterHash (pending : record_effects.RecordReceiveCommitment) (digest : Option Pqxdh.Bytes) :
    OracleComp RawCtxSourceOpen.OpenSpec (RustM RecordEffectsReceiveProgram.Result) :=
  RawCtxInterpretedOpening.bindResult (RecordEffectsReceiveProgram.compareDigest digest pending) fun matched =>
  RawCtxInterpretedOpening.bindResult (pending.resume matched) fun next =>
    match next with
    | .Rejected kernel => pure (ok (kernel, .None))
    | .AeadRequested opening => RecordEffectsReceiveProgram.executeAead opening
    | .KdfRequested _ | .CommitmentRequested _ => pure .div

theorem receiver_commitment (replies : Replies) (erased : Array Std.U8 227#usize)
    (pending : record_effects.RecordReceiveCommitment) :
    decodeResult <$> @beaconcrypt.ratchet.execute_record_receive (operations replies erased)
      (.CommitmentRequested pending) =
      simulateQ (implementation replies) (RecordEffectsReceiveProgram.execute erased (.CommitmentRequested pending)) := by
  let inst : Operations := operations replies erased
  rw [receiver_unfold]
  simp only [beaconcrypt.ratchet.execute_record_receive_loop.body,
    record_effects.RecordReceiveCommitment.transcript_mut, execute_commitment_hash, bind_tc_ok]
  have hashEq : @Operations.hash (operations replies erased) = fun transcript =>
      ok (replies.hash (PqxdhRefinement.absBytes transcript.bytes), { bytes := erased }) := rfl
  rw [hashEq]
  simp only [bind_tc_ok]
  rw [RecordEffectsReceiveProgram.execute, ← QueryImpl.simulateQ_compose]
  simp only [RecordEffectsReceiveProgram.executeCommitment,
    record_effects.RecordReceiveCommitment.transcript, record.OpenCommitment.impl.transcript,
    commitment.CommitmentTranscript.as_bytes, RawCtxInterpretedOpening.bindResult]
  rw [simulateQ_bind, simulateQ_spec_query]
  simp! only [record_effects.RecordReceiveCommitment.transcript_mut,
    commitment.CommitmentTranscript.as_mut_bytes, QueryImpl.apply_compose,
    RawCtxSourceOpen.openLift, implementation, simulateQ_spec_query,
    RecordEffectsReceiveProgram.compareDigest,
    record_effects.RecordReceiveCommitment.supplied_commitment,
    record.OpenCommitment.supplied_commitment, ratchet.concrete.ReceiveOpen.impl.context,
    RawCtxInterpretedOpening.bindResult, lift, bind_tc_ok]
  change _ = simulateQ (implementation replies ∘ₛ RawCtxSourceOpen.openLift)
    (afterHash { pending := { pending.pending with transcript := { bytes := erased } } }
      (Option.map (fun bytes => PqxdhRefinement.absBytes bytes)
        (replies.hash (PqxdhRefinement.absBytes pending.pending.transcript.bytes))))
  cases digestEq : replies.hash (PqxdhRefinement.absBytes pending.pending.transcript.bytes) with
  | none =>
      simp! only [digestEq, Option.map_none, bind_tc_ok,
        afterHash, RecordEffectsReceiveProgram.compareDigest,
        record_effects.RecordReceiveCommitment.resume, record.OpenCommitment.resume,
        ratchet.concrete.ReceiveOpen.reject, RawCtxInterpretedOpening.bindResult,
        simulateQ_pure, Bool.false_eq_true, ite_false]
      rw [receiver_unfold]
      rfl
  | some digest =>
      have compareEq : @beaconcrypt_crypto.utils.memcmp (operations replies erased) =
          fun left right => ok (decide (left.val.map PqxdhRefinement.absByte =
            right.val.map PqxdhRefinement.absByte)) := rfl
      rw [compareEq]
      simp! only [digestEq, Option.map_some, bind_tc_ok, Array.to_slice]
      cases matchedEq : decide (digest.val.map PqxdhRefinement.absByte =
        pending.pending.opening.context.commitment.val.map PqxdhRefinement.absByte) with
      | false =>
          simp! only [matchedEq, afterHash, RecordEffectsReceiveProgram.compareDigest,
            record_effects.RecordReceiveCommitment.supplied_commitment,
            record.OpenCommitment.supplied_commitment, ratchet.concrete.ReceiveOpen.impl.context,
            PqxdhRefinement.absBytes, record_effects.RecordReceiveCommitment.resume,
            record.OpenCommitment.resume, ratchet.concrete.ReceiveOpen.reject,
            RawCtxInterpretedOpening.bindResult, bind_tc_ok, Bool.false_eq_true, ite_false, simulateQ_pure]
          rw [receiver_unfold]
          rfl
      | true =>
          simp! only [matchedEq, afterHash, RecordEffectsReceiveProgram.compareDigest,
            record_effects.RecordReceiveCommitment.supplied_commitment,
            record.OpenCommitment.supplied_commitment, ratchet.concrete.ReceiveOpen.impl.context,
            PqxdhRefinement.absBytes, record_effects.RecordReceiveCommitment.resume,
            record.OpenCommitment.resume, RawCtxInterpretedOpening.bindResult, bind_tc_ok, ite_true]
          simpa only [RecordEffectsReceiveProgram.execute, ← QueryImpl.simulateQ_compose] using
            receiver_aead replies erased ⟨{ opening := pending.pending.opening }⟩

/-- Exact equality with the existing source request program for every starting record phase. -/
theorem receiver_source (replies : Replies) (erased : Array Std.U8 227#usize)
    (effect : record_effects.RecordReceiveEffect) :
    decodeResult <$> @beaconcrypt.ratchet.execute_record_receive (operations replies erased) effect =
      simulateQ (implementation replies) (RecordEffectsReceiveProgram.execute erased effect) := by
  let inst : Operations := operations replies erased
  generalize depthEq : RecordEffectsReceiveRank.rank effect = depth
  induction depth using Nat.strong_induction_on generalizing effect with
  | h depth ih =>
      cases effect with
      | KdfRequested pending =>
          rw [receiver_unfold]
          simp only [beaconcrypt.ratchet.execute_record_receive_loop.body,
            record_effects.RecordReceiveKdf.request, ratchet.concrete.ReceiveKdf.impl.request,
            ratchet_hkdf, bind_tc_ok]
          have kdfEq : @Operations.kdf (operations replies erased) pending.pending.request =
              ok (replies.kdf pending.pending.request) := rfl
          rw [kdfEq]
          simp only [bind_tc_ok]
          obtain ⟨next, resumed⟩ := BeaconcryptCore.PanicFreedom.RecordEffects.RecordReceiveKdf_resume_total
            pending (replies.kdf pending.pending.request)
          rw [resumed]
          simp only [bind_tc_ok]
          rw [RecordEffectsReceiveProgram.execute_kdf, simulateQ_bind, simulateQ_spec_query]
          change _ = simulateQ (implementation replies)
            (RawCtxInterpretedOpening.bindResult (pending.resume (replies.kdf pending.pending.request))
              (RecordEffectsReceiveProgram.execute erased))
          simp only [resumed, RawCtxInterpretedOpening.bindResult]
          exact ih _ (by simpa only [depthEq] using
            RecordEffectsReceiveRank.resume_decreasing pending _ next resumed) next rfl
      | Rejected kernel =>
          simp [receiver_unfold, beaconcrypt.ratchet.execute_record_receive_loop.body,
            RecordEffectsReceiveProgram.execute]
          rfl
      | CommitmentRequested pending => exact receiver_commitment replies erased pending
      | AeadRequested pending => exact receiver_aead replies erased pending

/-- Core admission followed by the actual generated Rust controller preserves the whole source execution. -/
theorem receive_source (replies : Replies) (erased : Array Std.U8 227#usize)
    (kernel : ratchet.concrete.ConcreteRatchetKernel) (sequence : Std.U64)
    (payload : Slice Std.U8) (ad : Array Std.U8 151#usize) (sender : Std.U64) :
    decodeResult <$> (do
      let effect ← record_effects.begin_record_receive kernel sequence payload ad sender
      @beaconcrypt.ratchet.execute_record_receive (operations replies erased) effect) =
      simulateQ (implementation replies)
        (RecordEffectsReceiveProgram.receive erased kernel sequence payload ad sender) := by
  obtain ⟨effect, admitted⟩ := BeaconcryptCore.PanicFreedom.RecordEffects.begin_record_receive_total
    kernel sequence payload ad sender
  simp only [RecordEffectsReceiveProgram.receive, admitted, bind_tc_ok,
    RawCtxInterpretedOpening.bindResult]
  exact receiver_source replies erased effect

/-- The selected production receive loop reaches the existing model bridge, including malformed admission and every optional primitive failure. -/
theorem receive_native_model (replies : Replies) (erased : Array Std.U8 227#usize)
    (kernel : ratchet.concrete.ConcreteRatchetKernel) (sequence : Std.U64)
    (payload : Slice Std.U8) (ad : Array Std.U8 151#usize) (sender : Std.U64) :
    decodeResult <$> (do
      let effect ← record_effects.begin_record_receive kernel sequence payload ad sender
      @beaconcrypt.ratchet.execute_record_receive (operations replies erased) effect) =
      simulateQ (implementation replies)
        (RawCtxInterpretedOpening.bindResult (record.OpenFrameContext.from_frame payload ad sender)
          (fun admitted => match admitted with
            | .None => pure (ok (kernel, .None))
            | .Some context => PqxdhOpenContextBridge.executeReceiveFrom erased kernel sequence context)) := by
  exact (receive_source replies erased kernel sequence payload ad sender).trans
    (congrArg (simulateQ (implementation replies))
      (RecordEffectsReceiveBridge.receive_execution erased kernel sequence payload ad sender))

