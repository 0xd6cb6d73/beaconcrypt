  let empty_cache = failed_receive_cache_empty() in
  let ready_state = failed_receive_state(first, chain_2, empty_cache) in

  (* Structural parsing, expected-sender checking, and the production minimum
     length guard have succeeded when this trace begins.  The canonical junk
     term is publicly constructible but cannot satisfy open_frame. *)
  in(c, forged_candidate: bitstring);
  if forged_candidate = forged_target_frame then
  (
    event MessageKeyCached(
      session,
      beacon_role(),
      server_to_beacon(),
      skipped_sequence,
      skipped_material
    );
    let cache_2 = failed_receive_cache_entry(
      skipped_sequence,
      skipped_material,
      empty_cache
    ) in
    event MessageKeyCached(
      session,
      beacon_role(),
      server_to_beacon(),
      target_sequence,
      retained_material
    );
    let cache_3 = failed_receive_cache_entry(
      target_sequence,
      retained_material,
      cache_2
    ) in
    let retained_state = failed_receive_state(
      target_sequence,
      chain_4,
      cache_3
    ) in
    let forged_plaintext = open_frame(
      retained_material,
      associated_data,
      target_sequence,
      sender_id,
      forged_candidate
    ) in
      event MessageReceived(
        session,
        server_to_beacon(),
        target_sequence,
        sender_id,
        receiver_id,
        forged_plaintext
      )
    else
    (
      event FailedReceiveStateAdvanced(
        session,
        target_sequence,
        retained_material,
        forged_target_frame,
        ready_state,
        retained_state
      );

      (* From receive counter three, the second forged target derives 48
         additional capabilities.  Together with sequences two and three,
         this reaches the production cache capacity of exactly 50. *)
      in(c, fill_candidate: bitstring);
      if fill_candidate = forged_fill_frame then
      (
        event MessageKeyCached(
          session,
          beacon_role(),
          server_to_beacon(),
          sequence_4,
          material_4
        );
        let cache_4 = failed_receive_cache_entry(
          sequence_4,
          material_4,
          cache_3
        ) in
        event MessageKeyCached(
          session,
          beacon_role(),
          server_to_beacon(),
          sequence_5,
          material_5
        );
        let cache_5 = failed_receive_cache_entry(
          sequence_5,
          material_5,
          cache_4
        ) in
        event MessageKeyCached(
          session,
          beacon_role(),
          server_to_beacon(),
          sequence_6,
          material_6
        );
        let cache_6 = failed_receive_cache_entry(
          sequence_6,
          material_6,
          cache_5
        ) in
        event MessageKeyCached(
          session,
          beacon_role(),
          server_to_beacon(),
          sequence_7,
          material_7
        );
        let cache_7 = failed_receive_cache_entry(
          sequence_7,
          material_7,
          cache_6
        ) in
        event MessageKeyCached(
          session,
          beacon_role(),
          server_to_beacon(),
          sequence_8,
          material_8
