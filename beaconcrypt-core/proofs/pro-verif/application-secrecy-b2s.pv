(* Exact selected fresh-publication secrecy under trusted application receive plaintext. *)
query k:bitstring,kid:key_id,root:bitstring,t:nat,m:bitstring;
 event(L2FreshPublished(beacon_to_server(),ed_public(SERVER_IDENTITY_SECRET),ed_public(k),kid,root,t,m)) && event(L2SelectedIdentity(k)) && attacker(m).
process L2Main(false)
