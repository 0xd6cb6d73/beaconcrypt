(* fs-records-b2s C5b, witness written as a correspondence (expected FALSE):
   failure neutrality.  "A rejected attempt at sequence t never precedes the
   acceptance of an honest Beacon's record at t" is false: a forged frame at
   t is rejected and the genuine record at t is accepted afterwards. *)
query s: bitstring, b: bitstring, kid: key_id, root: bitstring, t: nat, f: bitstring,
      m: bitstring, i: time, j: time;
  event(FsReceiveRejected(beacon_to_server(), s, b, kid, root, t, f))@i
  && event(FsReceived(beacon_to_server(), s, b, kid, root, t, m))@j
  && event(FsSent(beacon_to_server(), s, b, kid, root, t, m))
  ==> j < i.

process FsRecordsB2sMain()
