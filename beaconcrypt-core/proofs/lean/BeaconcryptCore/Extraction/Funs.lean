def pqxdh.beacon_start
  (state : pqxdh.BeaconFresh) (inputs : pqxdh.BeaconStartInputs)
  (coins : pqxdh.BeaconCoins) :
  Result pqxdh.BeaconStart
  := do
  let a ← pqxdh.tag_sign_key inputs.identity_public_key
  let a1 ←
    pqxdh.tag_x25519_key pqxdh.KEY_ROLE_PREKEY inputs.prekey_public_key
  let a2 ←
    pqxdh.tag_x25519_key pqxdh.KEY_ROLE_ONE_TIME coins.one_time_public_key
  let a3 ← pqxdh.tag_mlkem768_key inputs.pq_public_key
  ok
    {
      state :=
        {
          expected_server_binding := state.expected_server_binding,
          beacon_identity_public_key := inputs.identity_public_key
        },
      message :=
        { identity_key := a, prekey := a1, one_time_key := a2, pq_key := a3 }
    }

