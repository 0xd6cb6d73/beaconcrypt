@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: 0BSD
+
+//! Linux-only diagnostic boundaries; no probes run inside individual callbacks.
+
+use std::{
+	fs::File,
+	io::{self, BufRead, BufReader, Write},
+};
+
+pub(super) struct Control(Option<(File, BufReader<File>)>);
+
+impl Control {
+	pub(super) fn open() -> io::Result<Self> {
+		Ok(Self(
+			match (
+				std::env::var_os("BC_PROFILE_CONTROL"),
+				std::env::var_os("BC_PROFILE_ACK"),
+			) {
+				(None, None) => None,
+				(Some(control), Some(ack)) => Some((
+					File::options().write(true).open(control)?,
+					BufReader::new(File::open(ack)?),
+				)),
+				_ => {
+					return Err(io::Error::other(
+						"set both BC_PROFILE_CONTROL and BC_PROFILE_ACK",
+					));
+				}
+			},
+		))
+	}
+
+	pub(super) fn boundary(&mut self, event: &str, arm: &str, trial: usize) -> io::Result<()> {
+		let ended = if event == "end" {
+			Some(monotonic_ns()?)
+		} else {
+			None
+		};
+		if let Some((control, ack)) = &mut self.0 {
+			writeln!(
+				control,
+				"{}",
+				if event == "begin" {
+					"enable"
+				} else {
+					"disable"
+				}
+			)?;
+			control.flush()?;
+			// This perf version sends the terminating NUL as well as the newline.
+			let mut reply = Vec::new();
+			ack.read_until(0, &mut reply)?;
+			if reply != b"ack\n\0" {
+				return Err(io::Error::other(
+					"missing or invalid perf control acknowledgement",
+				));
+			}
+		}
+		let monotonic_ns = ended.map_or_else(monotonic_ns, Ok)?;
+		eprintln!(
+			"{}",
+			serde_json::json!({"profile_marker":true,"event":event,"arm":arm,"trial":trial,
+			"monotonic_ns":monotonic_ns})
+		);
+		Ok(())
+	}
+}
+
+fn monotonic_ns() -> io::Result<u64> {
+	let mut now = libc::timespec {
+		tv_sec: 0,
+		tv_nsec: 0,
+	};
+	if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut now) } != 0 {
+		return Err(io::Error::last_os_error());
+	}
+	Ok(now.tv_sec as u64 * 1_000_000_000 + now.tv_nsec as u64)
+}
+
+pub(super) fn scheduler_runtime_ns() -> Result<u64, String> {
+	std::fs::read_to_string("/proc/thread-self/schedstat")
+		.map_err(|error| error.to_string())?
+		.split_whitespace()
+		.next()
+		.ok_or_else(|| "missing scheduler runtime".to_owned())?
+		.parse::<u64>()
+		.map_err(|error| error.to_string())
+}
