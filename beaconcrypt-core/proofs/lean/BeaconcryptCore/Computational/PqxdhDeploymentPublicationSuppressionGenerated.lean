variable {ι : Type} {baseSpec : OracleSpec ι} {KemSK Reader Response A Result : Type}

abbrev ReportResult (KemSK A Result : Type) (count : Nat) :=
  (((Option (PqxdhDeploymentPublicationSuppressionInitialized.Outcome KemSK Result) ×
    PqxdhRegistrationJointIdentityCompiler.Local KemSK A) × PqxdhRegistrationJointIdentityRouting.Registry) ×
    (PqxdhJointPhase1Reports.Monitor count × PqxdhDynamicIdentityReports.ReportingState count))

/-- With a generated Server constructor, the actual modified handle client never imports a caller-known seed. -/
theorem initialized_free (setup : Setup baseSpec KemSK) (codec : Codec Reader Response) (checks : Checks)
    (ordinal : Nat) (program : OracleComp (PqxdhRegistrationJointRevealSchedule.Spec KemSK) Result) :
    (PqxdhRegistrationJointReportLift.lift
      (PqxdhDeploymentPublicationSuppressionInitialized.client setup codec checks none ordinal program)).IsQueryBoundP
      (fun query => birthImport (KemSK := KemSK) query = true) 0 := by
  have free := PqxdhDeploymentPublicationSuppressionCosts.initialized_local setup codec checks none ordinal program false
  have noImport : (PqxdhDeploymentPublicationSuppressionInitialized.client setup codec checks none ordinal program).IsQueryBoundP
      (fun query => birthImport (KemSK := KemSK) (.inl query) = true) 0 := by
    apply (isQueryBoundP_congr_pred (p := fun query =>
      PqxdhRegistrationJointOpenInitializedCosts.localClass (KemSK := KemSK) query = some false) ?_).mp free
    intro query
    cases query with
    | inl query => simp [birthImport, PqxdhRegistrationJointOpenInitializedCosts.localClass]
    | inr query => cases query <;> simp [birthImport, PqxdhRegistrationJointOpenInitializedCosts.localClass]
  exact PqxdhDeploymentPublishedTuple.lift_free _ _ noImport

set_option backward.isDefEq.respectTransparency false in
/-- Every actual source-run identity handle is generated by the ordinary challenger; suppression cannot introduce a known signing key. -/
theorem sourceClient_generated (setup : Setup baseSpec KemSK) (codec : Codec Reader Response) (checks : Checks)
    (ensureInit : StateT A ProbComp Bool) (ordinal count : Nat)
    (program : OracleComp (PqxdhRegistrationJointRevealSchedule.Spec KemSK) Result) (runtime : A)
    (reached : ReportResult KemSK A Result count)
    (supported : reached ∈ support (PqxdhJointPhase1Reports.run setup.joint count
      (PqxdhDeploymentPublicationSuppressionInitialized.sourceClient setup codec checks ensureInit none ordinal program runtime))) :
    AllGenerated reached.1.2 := by
  have client : reached.1 ∈ support
      (PqxdhDeploymentPublicationSuppressionInitialized.sourceClient setup codec checks ensureInit none ordinal program runtime) := by
    apply OracleComp.support_simulateQ_run'_subset (PqxdhJointPhase1Reports.sourceImpl setup.joint count) _
      (PqxdhJointPhase1Reports.initialMonitor count, ⟨PqxdhDynamicIdentityReports.initialSource count,
        PqxdhDynamicIdentityReports.initialSnapshot count, false, []⟩)
    rw [StateT.run'_eq, support_map]
    exact ⟨reached, supported, rfl⟩
  exact PqxdhDeploymentPublishedTuple.route_generated setup.joint _
    (PqxdhDeploymentPublishedTuple.compiled_free setup ensureInit _
      (initialized_free setup codec checks ordinal program) _) reached.1 client

set_option backward.isDefEq.respectTransparency false in
/-- The actual creation bill places every generated source handle inside the terminal report batch. -/
theorem generated_lt (setup : Setup baseSpec KemSK) (codec : Codec Reader Response) (checks : Checks)
    (ensureInit : StateT A ProbComp Bool) (ordinal count : Nat)
    (program : OracleComp (PqxdhRegistrationJointRevealSchedule.Spec KemSK) Result) (runtime : A)
    (creates : (PqxdhDeploymentPublicationSuppressionInitialized.sourceClient setup codec checks ensureInit none ordinal program runtime).IsQueryBoundP
      (PqxdhJointPhase1Reports.SourceClass PqxdhDynamicIdentityPool.IsCreate) count)
    (reached : ReportResult KemSK A Result count)
    (supported : reached ∈ support (PqxdhJointPhase1Reports.run setup.joint count
      (PqxdhDeploymentPublicationSuppressionInitialized.sourceClient setup codec checks ensureInit none ordinal program runtime)))
    (index target : Nat) (found : reached.1.2.refs[index]? = some (.generated target)) : target < count := by
  have tracked := PqxdhRegistrationJointRoutedReportSource.tracked setup.joint count _ reached supported
  have valid := tracked.valid target (List.mem_of_getElem? found)
  have bounded := PqxdhServerAuthExperiment.run_count (PqxdhJointPhase1Reports.sourceImpl setup.joint count)
    (PqxdhJointPhase1Reports.SourceClass PqxdhDynamicIdentityPool.IsCreate)
    (fun current => current.2.source.2.seeds.length) (PqxdhDeploymentPublishedTuple.source_seeds setup.joint count)
    _ count creates _ reached supported
  simp only [PqxdhDynamicIdentityReports.initialSource, PqxdhDynamicIdentityPool.initialState, List.length_nil,
    Nat.zero_add] at bounded
  exact lt_of_lt_of_le valid bounded

