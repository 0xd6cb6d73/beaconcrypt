(* ProVerif does not classify positive reachability in passive-attacker mode. These active-scheduler controls use the same bounded honest-only process. Every secrecy canary is named explicitly so an unreachable send/receive branch cannot make a passive secrecy result pass vacuously. *)
query server_identity: bitstring,
      beacon_identity: bitstring,
      init: beaconcrypt_core__pqxdh__t_InitKex,
      registration_id: beaconcrypt_core__pqxdh__t_RegistrationId,
      assigned_key_id: key_id,
      root_input: beaconcrypt_core__pqxdh__t_RootKeyInput,
      root: bitstring,
      associated_data: bitstring,
      session: bitstring,
      origin: bitstring;
  event(BeaconCommitted(
    server_identity,
    beacon_identity,
    init,
    registration_id,
    assigned_key_id,
    root_input,
    root,
    associated_data,
    session,
    origin
  )).

query session: bitstring, sender: key_id, receiver: key_id;
  event(MessageReceived(
    session,
    server_to_beacon(),
    first_sequence(),
    sender,
    receiver,
    INITIAL_SECRET
  )).

query session: bitstring, sender: key_id, receiver: key_id;
  event(MessageReceived(
    session,
    server_to_beacon(),
    next_sequence(first_sequence()),
    sender,
    receiver,
    CACHED_SECRET
  )).

query session: bitstring, sender: key_id, receiver: key_id;
  event(MessageReceived(
    session,
    server_to_beacon(),
    next_sequence(next_sequence(first_sequence())),
    sender,
    receiver,
    ADVANCE_SECRET
  )).

query session: bitstring, sender: key_id, receiver: key_id;
  event(MessageReceived(
    session,
    server_to_beacon(),
    next_sequence(next_sequence(next_sequence(first_sequence()))),
    sender,
    receiver,
    FUTURE_SECRET
  )).

query session: bitstring, sender: key_id, receiver: key_id;
  event(MessageReceived(
    session,
    beacon_to_server(),
    first_sequence(),
    sender,
    receiver,
    BEACON_RECORD_SECRET
  )).
