(* One actual first-sequence Beacon and Server role; this is a reachable instance of baseline.pv. *)
process
  out(c, ed_public(SERVER_IDENTITY_SECRET));
  (
    HonestBeacon(BEACON_RECORD_SECRET)
    | Server(INITIAL_SECRET, CACHED_SECRET, ADVANCE_SECRET, FUTURE_SECRET)
    | KeepBeaconStatePrivate()
  )
