(* SPDX-License-Identifier: 0BSD *)

(* All four properties must be false.
   This is an expected attack witness, not a positive active post-quantum security theorem. *)
query attacker(INITIAL_SECRET).

query selected_pq_public_key: bitstring,
      server_ephemeral: bitstring,
      kem_ciphertext: bitstring,
      initial_frame: bitstring,
      response: bitstring,
      root_input: beaconcrypt_core__pqxdh__t_RootKeyInput,
      root: bitstring;
  event(QuantumInitialSecretRecovered(
    selected_pq_public_key,
    server_ephemeral,
    kem_ciphertext,
    initial_frame,
    response,
    root_input,
    root,
    INITIAL_SECRET
  )).

query server_identity: bitstring,
      beacon_identity: bitstring,
      init: beaconcrypt_core__pqxdh__t_InitKex,
      registration_id: beaconcrypt_core__pqxdh__t_RegistrationId,
      root_input: beaconcrypt_core__pqxdh__t_RootKeyInput,
      root: bitstring,
      origin: bitstring;
  inj-event(ServerAccepted(
    server_identity,
    beacon_identity,
    init,
    registration_id,
    root_input,
    root,
    origin
  )) ==>
  inj-event(BeaconInitiated(
    server_identity,
    beacon_identity,
    init,
    registration_id,
    origin
  )).

query bundle: authenticated_init_bundle_t;
  inj-event(ServerBundleAccepted(bundle)) ==>
  inj-event(BeaconBundleInitiated(bundle)).
