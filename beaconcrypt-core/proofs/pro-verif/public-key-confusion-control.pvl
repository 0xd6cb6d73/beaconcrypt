(**************************************************************************)
(* Production public-key encoding confusion controls                    *)
(**************************************************************************)

(* These parsers recognize only the corresponding production encoding constructor, so legitimate parsing is reachable while an algorithm-tag or X25519-role substitution blocks before acceptance. *)
reduc forall public_key: bitstring;
  pk_confusion_parse_mlkem768(tag_mlkem768(public_key)) = public_key.
reduc forall public_key: bitstring;
  pk_confusion_parse_x25519_prekey(
    tag_x25519_prekey(public_key)
  ) = public_key.
reduc forall public_key: bitstring;
  pk_confusion_parse_x25519_one_time(
    tag_x25519_one_time(public_key)
  ) = public_key.

free PK_ALGORITHM_MLKEM_PARSE_WITNESS: bitstring [private].
free PK_ALGORITHM_X25519_PARSE_WITNESS: bitstring [private].
free PK_ALGORITHM_CONFUSION_WITNESS: bitstring [private].
free PK_ROLE_PREKEY_PARSE_WITNESS: bitstring [private].
free PK_ROLE_ONE_TIME_PARSE_WITNESS: bitstring [private].
free PK_ROLE_CONFUSION_WITNESS: bitstring [private].

event PkAlgorithmMlkemLegitimateParsed(bitstring).
event PkAlgorithmX25519LegitimateParsed(bitstring).
event PkAlgorithmConfusionAttempted(bitstring).
event PkAlgorithmConfusionAccepted(bitstring).
event PkRolePrekeyLegitimateParsed(bitstring).
event PkRoleOneTimeLegitimateParsed(bitstring).
event PkRoleConfusionAttempted(bitstring).
event PkRoleConfusionAccepted(bitstring).

let StrongAlgorithmTagConfusionControl() =
  new public_key: bitstring;
  let encoded_mlkem = tag_mlkem768(public_key) in
  let encoded_x25519 = tag_x25519_prekey(public_key) in
  (
    let parsed_mlkem = pk_confusion_parse_mlkem768(encoded_mlkem) in
    if parsed_mlkem = public_key then
      event PkAlgorithmMlkemLegitimateParsed(
        PK_ALGORITHM_MLKEM_PARSE_WITNESS
      )
  |
    let parsed_x25519 = pk_confusion_parse_x25519_prekey(
      encoded_x25519
    ) in
    if parsed_x25519 = public_key then
      event PkAlgorithmX25519LegitimateParsed(
        PK_ALGORITHM_X25519_PARSE_WITNESS
      )
  |
    event PkAlgorithmConfusionAttempted(
      PK_ALGORITHM_CONFUSION_WITNESS
    );
    let confused_x25519 = pk_confusion_parse_x25519_prekey(
      encoded_mlkem
    ) in
    if confused_x25519 = public_key then
      event PkAlgorithmConfusionAccepted(
        PK_ALGORITHM_CONFUSION_WITNESS
      )
  ).

let StrongX25519RoleConfusionControl() =
  new public_key: bitstring;
  let encoded_prekey = tag_x25519_prekey(public_key) in
  let encoded_one_time = tag_x25519_one_time(public_key) in
  (
    let parsed_prekey = pk_confusion_parse_x25519_prekey(
      encoded_prekey
    ) in
    if parsed_prekey = public_key then
      event PkRolePrekeyLegitimateParsed(PK_ROLE_PREKEY_PARSE_WITNESS)
  |
    let parsed_one_time = pk_confusion_parse_x25519_one_time(
      encoded_one_time
    ) in
    if parsed_one_time = public_key then
      event PkRoleOneTimeLegitimateParsed(
        PK_ROLE_ONE_TIME_PARSE_WITNESS
      )
  |
    event PkRoleConfusionAttempted(PK_ROLE_CONFUSION_WITNESS);
    let confused_one_time = pk_confusion_parse_x25519_one_time(
      encoded_prekey
    ) in
    if confused_one_time = public_key then
      event PkRoleConfusionAccepted(PK_ROLE_CONFUSION_WITNESS)
  ).
