  let chain_51 = ratchet_next(chain_50) in
  let chain_52 = ratchet_next(chain_51) in
  let chain_53 = ratchet_next(chain_52) in
  let material_1 = ratchet_material(chain_1) in
  let skipped_material = ratchet_material(chain_2) in
  let retained_material = ratchet_material(chain_3) in
  let material_4 = ratchet_material(chain_4) in
  let material_5 = ratchet_material(chain_5) in
  let material_6 = ratchet_material(chain_6) in
  let material_7 = ratchet_material(chain_7) in
  let material_8 = ratchet_material(chain_8) in
