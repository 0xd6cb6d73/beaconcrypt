  "idealPair, erase_ideal (design-v2 4)": "idealPair (FinishPair over any slot service; idealPair_reg, idealPair_erased), erase_ideal (erase_game_ctx at idealPair, up to fullX), erase_idealGame and idealGameErased for CE.idealGame g",
  "represent_split instance (5.2 step 1)": "represent_ideal",
  "seed_move (5.2 step 2)": "generic slotCoreX, moveSeeds, slotCore_moveSeeds, game_moveSeeds; instance seed_move; first-touch split form idealSplitX; ideal_to_splitX",
  "conditional-read kernel identities (5.2 step 3)": "split_kernel: idealSplitX = idealSplitEager exactly (eagerDummy service, xPeek seed fixes with buildApply and stepApply), from buildHidden_seed, nativeCtx_erased_seed, finish_withKernel, acceptStep_ignores; ideal_to_splitEager",
  "two-point defer, split_game (5.2 step 4)": "discard_erase_list, PointedSeeds, defer_seeds (list points under the invariant InvX), eager_lazy, xInstall, xInstall_peek, splitSeeds, split_game (up to seedFree)",
  "idealSplit (5.2)": "idealSplit: lazyDummy slot steps, serverInstall after the marked build (gate publishedKey), beaconInstall after owner k's challenge finish (gate establishedAt)",
  "ideal_to_split (5.2)": "ideal_to_split (up to splitView)",
  "seed_at_install (5.2 step 5, F4)": "not built in U2; moved to U3 as a conjunct of the U3 invariant"
 },
 "deviations_from_design": [
  "four modules (PqxdhDeploymentIdealErase, PqxdhDeploymentIdealKeys, PqxdhDeploymentIdealKernel, PqxdhDeploymentIdealDefer) instead of one, each registered before creation",
  "C7 pointed finish built as a slot program on pairs (onPair, slotCore_factor) with owner k's grouped finish restructured (ownerRun), instead of factor_prefix/factor_suffix on the game state",
  "kernel identities through an intermediate eager split form (exact, no invariant) instead of conditional seed reads under an invariant",
  "deferral with lists of points under a state invariant instead of the two-point PointedReg with the single-point defer",
  "seed_at_install (F4) moved to U3: needs the run facts I4 and I5 of IdealInv (ghost writes overwrite); statement unchanged",
  "central 14f51c34 (record-lift CTX track) not merged into the topic during the unit"
 ],
