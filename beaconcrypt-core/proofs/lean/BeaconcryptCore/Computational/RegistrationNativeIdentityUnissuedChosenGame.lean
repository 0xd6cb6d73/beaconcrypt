 Classical.choice,
 Quot.sound] -/
#guard_msgs in
#print axioms BeaconcryptCore.Computational.RegistrationNativeIdentityUnissuedChosenGame.game_eq

/-- info: 'BeaconcryptCore.Computational.RegistrationNativeIdentityUnissuedChosenGame.probability_eq' depends on axioms: [propext,
 Classical.choice,
 Quot.sound] -/
#guard_msgs in
#print axioms BeaconcryptCore.Computational.RegistrationNativeIdentityUnissuedChosenGame.probability_eq
