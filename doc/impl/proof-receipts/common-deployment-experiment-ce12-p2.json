 "headlines": {
  "server_gap / server_gap_bound": "on every outcome: SymServer peer not designated inside the budget -> OwnerForgery at the owner of the accepted identity key with NoBundleFailureAt; 𝒟[ServerGap] <= ε_A2pub (a2pubTerm, a2pub_owner_bound); premises shortRejects, Phase1ReadBack, Phase2ReadBack, budget",
  "beacon_gap / beacon_gap_le / ce_a1_linked": "SymBeacon owner (pin S, serverKid) not designated -> A1NoPinnedMatch or CtGap; 𝒟[BeaconGap] <= 𝒟[∃c A1NoPinnedMatch c] + ctGapTerm <= ofReal ε_A1 + ctGapTerm, with the bills of every CE-A1 reduction; premises those of CE-A1",
  "sym_gap": "𝒟[ServerGap ∨ BeaconGap] <= ε_A2pub + ofReal ε_A1 + ctGapTerm",
  "finish_accepted": "on every outcome: finishOf tr c = some raw <-> ∃ before, accepted c (regsOf tr) = some (before, raw) (new run invariant FinishReady, ready_game)",
  "identity_collision_game": "𝒟[IdentityCollision] <= ε_inj (injTerm); premises Phase1ReadBack, Phase2ReadBack, budget",
  "pair_cp_le": "pairCollision setup <= ofReal Adv^IND-CCA(pairAdversary) + 2·ofReal correctnessError + 2^-256; premise FunctionalDecapsulation; pairAdversary: no pre-challenge query, no decapsulation query after the challenge",
  "ce_or_b2s_sym": "𝒟[OriginFailureSym .b2s] <= ce_or_b2s bound + ε_A2pub",
  "ce_or_s2b_sym": "𝒟[OriginFailureSym .s2b] <= ce_or_s2b bound + ofReal ε_A1 + ctGapTerm + ctCollTerm",
  "ce_uks_sym": "𝒟[UksFailureSym] <= ce_uks_sender bound + ofReal ε_A1 + ctGapTerm + ctCollTerm",
  "ce_app_sym": "𝒟[AppWinSym] <= ce_app bound + (ε_A2pub + ofReal ε_A1 + ctGapTerm)",
  "ce_app_server_sym": "𝒟[AppWinPeerSym] <= ce_app_server bound + ε_A2pub",
  "ce_kt_sym": "𝒟[KtSym] <= ce_kt_sum_le bound + (ε_A2pub + ofReal ε_A1 + ctGapTerm)",
  "symbolic_lor": "ofReal |adv_sym - adv_CE(nbfFilter)| <= 2⁻¹ * (ε_A2pub + ofReal ε_A1 + ctGapTerm + ε_inj + ctCollTerm), adv = Pr[win] - ½Pr[eligible]",
  "symbolic_lor_bound": "ofReal |adv_sym| <= ce_lor bound at nbfFilter + 2⁻¹ * (ε_A2pub + ofReal ε_A1 + ctGapTerm + ε_inj + ctCollTerm)",
  "ce_or_injective_b2s": "𝒟[OriginFailureSym .b2s ∨ ReplayOwnerEvent ∨ PeerReplay] <= ce_or_b2s bound + ε_A2pub",
  "ce_or_injective_s2b": "𝒟[OriginFailureSym .s2b ∨ (∃ c c', SharedMatch c c') ∨ OwnerReplay] <= ce_or_s2b bound + ofReal ε_A1inj + ctGapTerm + ctCollTerm (ε_A1inj = ce_a1_injective right side)",
  "pair_bills": "(pairAdversary setup.kem).MakesAtMostQueries 0 0 0 caps.encapsUniform caps.encapsBase 0 (KemBound)",
  "auth_bills / records_bills": "RecordAuthBounded / RecordBounded of record_auth_lift / record_lift at envGD of each target with the frame of frame_idealD, at BI_g = inputG caps qInit budget bounds"
 },
