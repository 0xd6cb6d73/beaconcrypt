(* SPDX-License-Identifier: 0BSD *)

(**************************************************************************)
(* fs-records-s2b: registration, then Server-to-Beacon records            *)
(**************************************************************************)

(* Unbounded Server objects share the one honest Server identity (OD2).  Each
   object processes one registration bundle (K_reg = 1 per object; the
   pending obligation L2 maps a Rust object with several peers to several
   model objects), builds the response for it on an attacker-chosen build
   input, and then sends the Server taskings at sequences 2 and 3 (K_s = 2)
   to the installed peer.  Unbounded honest Beacons run alongside: each
   sends one bundle, finishes registration at most once and then makes K_r
   attacker-scheduled receive attempts from r = 1 (K_r = 3 for the security
   results), with the receive state (r and the cached flag of position 2) in
   process variables.  Positions up to T_max = 3 are materialised; a frame
   above T_max goes to the far branch.  The attacker builds its own identities
   from the public constructors and the same Server code serves them;
   honesty appears only in the queries.  Every attacker input is [precise].

   Loaded after fs-common.pvl and, in this order, one receive-window library
   (fs-records-s2b-window.pvl or one of the controls fs-control-retain.pvl,
   fs-control-stale.pvl and fs-control-failmut.pvl), one finish-gate
   library (fs-records-s2b-gate.pvl or the control fs-control-nogate.pvl),
   one taskings library (fs-records-s2b-taskings.pvl with fresh application
   plaintexts, or fs-records-s2b-taskings-chosen.pvl, which also lets the
   application send adversary-chosen plaintexts), the receive step
   fs-records-s2b-receive.pvl and one bound file fs-records-s2b-kr1.pvl,
   -kr2.pvl or -kr3.pvl (K_r receive attempts).

   Model steps (justified in doc/impl/proverif-free-schedule-records.md):
   - Early fresh Server coins (v2): the Server ephemeral secret and the KEM
     coins are drawn when the object starts rather than at server.rs:368
     and :373.  With one bundle per object their values are unobservable
     until the response is output, and a failed accept discards them in
     both orders (argument E20, written in the guide, not yet reviewed).
   - The direction split: no Beacon send worker and no Server receive
     worker (argument E19, written in the guide, not yet reviewed).
   - The far branch: a frame above T_max is opened with material derived
     from the public function fs_far_chain applied to the chain at T_max+1,
     emits only FsFarAccepted and ends the receive worker (OD4, pending L3);
     see fs-records-s2b-receive.pvl.
   - The finish opens its frame at sequences 1..T_max before the
     sequence-one gate; a later sequence emits FsBeaconFinishOpenedLater and
     then reaches the gate library, which aborts.
   - The response payload is a fresh name; the later taskings follow the
     taskings library.
   - All the Server's own frames carry the sender SERVER_KEY_ID, and every
     peer gets the key ID fs_kid(1) (one build per object). *)

(* One Server object: one registration in Rust order, the response build on
   an attacker-chosen input, then the taskings to the installed peer. *)
let FsS2bServer(obj: bitstring) =
  let server_identity = ed_public(SERVER_IDENTITY_SECRET) in
  (* Early fresh coins (v2), drawn before the bundle input. *)
  (* @beaconcrypt-fs-fidelity key=server.fresh_ephemeral src=beaconcrypt/src/server.rs:368-368 anchor=let ephemeral = crypto_kx::KeyPair::generate().ok()?; *)
  new ephemeral_secret: bitstring;
  (* @beaconcrypt-fs-fidelity key=server.encapsulate src=beaconcrypt/src/server.rs:373-373 anchor=let (kem_ciphertext, kem_shared) = crypto_kem::mlkem768::encapsulate(&pq_pub).ok()?; *)
  new kem_coins: bitstring;
  (* @beaconcrypt-fs-fidelity key=server.accept src=beaconcrypt/src/server.rs:332-336 anchor=fn get_shared_secret(&mut self, buffer: &[u8]) -> Option<RegistrationOutput> { *)
  in(c, bundle: bitstring) [precise];
  (* @beaconcrypt-fs-fidelity key=server.identity_tag src=beaconcrypt/src/server.rs:337-342 anchor=let encoded_identity: [u8; verified_pqxdh::ENCODED_SIGN_PUBLIC_KEY_SIZE] = *)
  let signed_init_kex(
    tag_ed25519(identity: bitstring),
    signed_prekey: bitstring,
    signed_one_time: bitstring,
    signed_pq: bitstring
  ) = bundle in
  (* @beaconcrypt-fs-fidelity key=server.signatures src=beaconcrypt/src/server.rs:343-346 anchor=let pq_verified = crypto_sign::verify(registration.get_pq_key().ok()?, &remote_id)?; *)
  (* @beaconcrypt-fs-fidelity key=server.validate_init_kex src=beaconcrypt/src/server.rs:347-353 anchor=let init_kex = verified_pqxdh::InitKex::from_encoded( *)
  (* @beaconcrypt-fs-fidelity key=core.validate_init_kex src=beaconcrypt-core/src/pqxdh.rs:325-345 anchor=pub fn validate_init_kex(message: InitKex) -> Result<VerifiedInitKex, RegistrationError> { *)
  let (
    tag_mlkem768(pq: bitstring),
    tag_x25519_prekey(prekey: bitstring),
    tag_x25519_one_time(one_time: bitstring)
  ) = (
    verify_signature(signed_pq, identity),
    verify_signature(signed_prekey, identity),
    verify_signature(signed_one_time, identity)
  ) in
  let init = beaconcrypt_core__pqxdh__VerifiedInitKex(
    identity,
    prekey,
    one_time,
    pq
  ) in
  (* @beaconcrypt-fs-fidelity key=server.registration_id src=beaconcrypt/src/server.rs:354-354 anchor=let registration_id = *verified_pqxdh::registration_id(&verified_registration).as_bytes(); *)
  (* @beaconcrypt-fs-fidelity key=core.registration_id src=beaconcrypt-core/src/pqxdh.rs:195-204 anchor=pub fn registration_id(&self) -> RegistrationId { *)
  let registration_id = beaconcrypt_core__pqxdh__registration_id(init) in
  (* With one bundle per object the consumed set is empty here, so the
     status is always Fresh. *)
  (* @beaconcrypt-fs-fidelity key=server.consumed_status src=beaconcrypt/src/server.rs:355-360 anchor=let registration_status = if self.consumed_registrations.contains(&registration_id) { *)
  (* @beaconcrypt-fs-fidelity key=server.identity_conversion src=beaconcrypt/src/server.rs:374-375 anchor=let remote_id_kex = crypto_sign::ed25519_pk_to_curve25519(&remote_id).ok()?; *)
  (* @beaconcrypt-fs-fidelity key=server.dh src=beaconcrypt/src/server.rs:376-394 anchor=let dh1: DhSecret = crypto_scalarmult::scalarmult(&id_kex_sk, beacon_prekey.as_bytes()) *)
  let (dh1: bitstring, dh2: bitstring, dh3: bitstring, dh4: bitstring) = (
    x25519_server_dh(SERVER_IDENTITY_SECRET, prekey),
    x25519_server_dh(ephemeral_secret, x25519_public_from_ed(identity)),
    x25519_server_dh(ephemeral_secret, prekey),
    x25519_server_dh(ephemeral_secret, one_time)
  ) in
  (* @beaconcrypt-fs-fidelity key=server.accept_root_input src=beaconcrypt/src/server.rs:395-411 anchor=let mut secrets = shared_secrets(dh1, dh2, dh3, dh4, &kem_shared)?; *)
  (* @beaconcrypt-fs-fidelity key=core.root_input src=beaconcrypt-core/src/pqxdh.rs:391-405 anchor=let bytes: [u8; ROOT_KEY_INPUT_SIZE] = core::array::from_fn(|i| { *)
  (* @beaconcrypt-fs-fidelity key=server.root src=beaconcrypt/src/server.rs:414-414 anchor=let derived_secret = derive_root_key_input(pending.root_key_input_mut())?; *)
  let root_input = beaconcrypt_core__pqxdh__build_root_key_input(
    beaconcrypt_core__pqxdh__PqxdhSharedSecrets(
      dh1,
      dh2,
      dh3,
      dh4,
      mlkem_shared_secret(pq, kem_coins)
    )
  ) in
  let root = pqxdh_root(
    beaconcrypt_core__pqxdh__t_RootKeyInput_to_bitstring(root_input)
  ) in
  (* @beaconcrypt-fs-fidelity key=server.insert src=beaconcrypt/src/server.rs:415-416 anchor=let inserted = self.consumed_registrations.insert(registration_id); *)
  (* @beaconcrypt-fs-fidelity key=server.accept_return src=beaconcrypt/src/server.rs:418-421 anchor=Some(RegistrationOutput { *)
  event FsServerAccepted(
    obj,
    server_identity,
    identity,
    init,
    registration_id,
    root
  );
  (* build_registration_response is a separate call: any input schedules
     the build, and withholding it is the dropped token.  The object takes
     no further bundle, so a test on the input value, as in fs-registration,
     would select no further behaviour; it only slowed saturation. *)
  (* @beaconcrypt-fs-fidelity key=server.build src=beaconcrypt/src/server.rs:424-428 anchor=fn build_registration_response( *)
  in(c, build_request: bitstring) [precise];
  (* The first build of the object: key ID server_kid + 1; occupancy is
     Available. *)
  (* @beaconcrypt-fs-fidelity key=server.next_key_id src=beaconcrypt/src/server.rs:434-439 anchor=let next_key_id = verified_pqxdh::server_next_key_id(control).ok()?; *)
  let assigned_key_id = fs_kid(1) in
  (* @beaconcrypt-fs-fidelity key=server.prepare_commit src=beaconcrypt/src/server.rs:440-449 anchor=let candidate = verified_pqxdh::server_prepare_commit( *)
  (* @beaconcrypt-fs-fidelity key=core.prepare_commit_ad src=beaconcrypt-core/src/pqxdh.rs:877-880 anchor=associated_data: build_associated_data( *)
  (* @beaconcrypt-fs-fidelity key=server.ratchet_start src=beaconcrypt/src/server.rs:456-457 anchor=let pending = start_server_candidate_ratchet_kdf(&candidate, derived_secret.as_array()); *)
  let send_chain_1 = server_to_beacon_chain(root) in
  let send_chain_2 = ratchet_next(send_chain_1) in
  let send_chain_3 = ratchet_next(send_chain_2) in
  (* @beaconcrypt-fs-fidelity key=server.associated_data src=beaconcrypt/src/server.rs:458-458 anchor=let associated_data = *candidate.associated_data(); *)
  (* @beaconcrypt-fs-fidelity key=core.associated_data src=beaconcrypt-core/src/pqxdh.rs:928-947 anchor=pub fn build_associated_data( *)
  let associated_data = beaconcrypt_core__pqxdh__build_associated_data(
    server_identity,
    identity
  ) in
  (* @beaconcrypt-fs-fidelity key=server.payload src=beaconcrypt/src/server.rs:459-462 anchor=let plaintext = data.unwrap_or(REGISTRATION_WITNESS); *)
  new payload: bitstring;
  (* @beaconcrypt-fs-fidelity key=server.binding src=beaconcrypt/src/server.rs:463-470 anchor=let authenticated_len = *)
  let response_plaintext = registration_payload(
    beaconcrypt_core__pqxdh__RegistrationKeyIdBinding(
      key_id_encoding(assigned_key_id)
    ),
    payload
  ) in
  (* @beaconcrypt-fs-fidelity key=server.seal src=beaconcrypt/src/server.rs:471-479 anchor=let encrypted = encrypt_message_with_ratchet( *)
  let initial_frame = seal_frame(
    ratchet_material(send_chain_1),
    associated_data,
    fs_seq(1),
    SERVER_KEY_ID,
    response_plaintext
  ) in
  (* @beaconcrypt-fs-fidelity key=server.commit src=beaconcrypt/src/server.rs:489-497 anchor=let (next_control, established_peer) = verified_pqxdh::server_commit(candidate); *)
  event FsServerCommitted(
    obj,
    server_identity,
    identity,
    init,
    assigned_key_id,
    root,
    associated_data,
    payload
  );
  event FsSent(
    server_to_beacon(),
    server_identity,
    identity,
    assigned_key_id,
    root,
    1,
    response_plaintext
  );
  (* @beaconcrypt-fs-fidelity key=server.build_return src=beaconcrypt/src/server.rs:498-501 anchor=Some(RegResponse { *)
  out(
    c,
    kex_response(
      server_identity,
      x25519_public(ephemeral_secret),
      mlkem_ciphertext(pq, kem_coins),
      initial_frame,
      assigned_key_id
    )
  );
  FsS2bTaskings(
    server_identity,
    identity,
    assigned_key_id,
    root,
    associated_data,
    send_chain_2,
    send_chain_3
  ).

(* One honest Beacon object: one registration, a terminal abort on any
   finish failure, then the receive attempts.  Every model Beacon pins the
   honest Server key and outputs nothing after its bundle. *)
let FsS2bBeacon() =
  (* @beaconcrypt-fs-fidelity key=beacon.new src=beaconcrypt/src/beacon.rs:65-83 anchor=pub fn try_new(server_kid: u64, server_id_pk: &[u8]) -> Result<Self, crate::KeyGenError> { *)
  new beacon_identity_secret: bitstring;
  new beacon_prekey_secret: bitstring;
  new beacon_pq_secret: bitstring;
  (* @beaconcrypt-fs-fidelity key=beacon.one_time src=beaconcrypt/src/beacon.rs:301-305 anchor=let mut generated_onetime = if matches!(&self.state, BeaconState::Fresh { .. }) { *)
  new beacon_one_time_secret: bitstring;
  let server_identity = ed_public(SERVER_IDENTITY_SECRET) in
  let beacon_identity = ed_public(beacon_identity_secret) in
  let beacon_prekey = x25519_public(beacon_prekey_secret) in
  let beacon_one_time = x25519_public(beacon_one_time_secret) in
  let beacon_pq = mlkem_public(beacon_pq_secret) in
  let init = beaconcrypt_core__pqxdh__VerifiedInitKex(
    beacon_identity,
    beacon_prekey,
    beacon_one_time,
    beacon_pq
  ) in
  let registration_id = beaconcrypt_core__pqxdh__registration_id(init) in
  (* @beaconcrypt-fs-fidelity key=beacon.start src=beaconcrypt/src/beacon.rs:335-345 anchor=let started = verified_pqxdh::beacon_start( *)
  (* @beaconcrypt-fs-fidelity key=core.beacon_start src=beaconcrypt-core/src/pqxdh.rs:304-321 anchor=pub fn beacon_start( *)
  event FsBeaconStarted(server_identity, beacon_identity, init, registration_id);
  (* @beaconcrypt-fs-fidelity key=beacon.sign src=beaconcrypt/src/beacon.rs:349-357 anchor=let prekey_sig = crypto_sign::sign(started.message.prekey(), self.identity_sk()).ok()?; *)
  (* @beaconcrypt-fs-fidelity key=beacon.bundle_return src=beaconcrypt/src/beacon.rs:398-398 anchor=Some(buffer) *)
  out(
    c,
    signed_init_kex(
      tag_ed25519(beacon_identity),
      sign(tag_x25519_prekey(beacon_prekey), beacon_identity_secret),
      sign(tag_x25519_one_time(beacon_one_time), beacon_identity_secret),
      sign(tag_mlkem768(beacon_pq), beacon_identity_secret)
    )
  );
  (* @beaconcrypt-fs-fidelity key=beacon.finish src=beaconcrypt/src/beacon.rs:402-406 anchor=fn finish_registration(&mut self, bytes: &[u8]) -> Option<Vec<u8>> { *)
  in(c, response: bitstring) [precise];
  (* @beaconcrypt-fs-fidelity key=beacon.decode src=beaconcrypt/src/beacon.rs:422-431 anchor=let reader = capnp::serialize_packed::read_message(bytes, ReaderOptions::new()).ok()?; *)
  let kex_response(
    response_server_identity,
    server_ephemeral,
    kem_ciphertext,
    initial_frame,
    assigned_key_id
  ) = response in
  (* @beaconcrypt-fs-fidelity key=beacon.identity_conversion src=beaconcrypt/src/beacon.rs:432-433 anchor=let server_kex_id = crypto_sign::ed25519_pk_to_curve25519(&response_server).ok()?; *)
  let server_identity_x = x25519_public_from_ed(response_server_identity) in
  (* @beaconcrypt-fs-fidelity key=beacon.decapsulate src=beaconcrypt/src/beacon.rs:434-434 anchor=let kem_shared = crypto_kem::mlkem768::decapsulate(&kem_ciphertext, pq_secret).ok()?; *)
  let kem_secret = mlkem_decapsulate(kem_ciphertext, beacon_pq_secret) in
  (* @beaconcrypt-fs-fidelity key=beacon.dh src=beaconcrypt/src/beacon.rs:435-449 anchor=let dh1: DhSecret = *)
  let dh1 = x25519_beacon_dh(beacon_prekey_secret, server_identity_x) in
  let dh2 = x25519_beacon_dh(beacon_identity_secret, server_ephemeral) in
  let dh3 = x25519_beacon_dh(beacon_prekey_secret, server_ephemeral) in
  let dh4 = x25519_beacon_dh(beacon_one_time_secret, server_ephemeral) in
  (* @beaconcrypt-fs-fidelity key=beacon.prepare src=beaconcrypt/src/beacon.rs:450-457 anchor=let mut finish_inputs = verified_pqxdh::BeaconFinishInputs { *)
  (* @beaconcrypt-fs-fidelity key=core.pin_check src=beaconcrypt-core/src/pqxdh.rs:545-547 anchor=if !(state.expected_server_binding.identity_public_key == inputs.response_server_identity) { *)
  if response_server_identity = server_identity then
  (* @beaconcrypt-fs-fidelity key=beacon.root src=beaconcrypt/src/beacon.rs:458-458 anchor=let derived_secret = derive_root_key_input(candidate.root_key_input_mut())?; *)
  let root_input = beaconcrypt_core__pqxdh__build_root_key_input(
    beaconcrypt_core__pqxdh__PqxdhSharedSecrets(
      dh1,
      dh2,
      dh3,
      dh4,
      kem_secret
    )
  ) in
  let root = pqxdh_root(
    beaconcrypt_core__pqxdh__t_RootKeyInput_to_bitstring(root_input)
  ) in
  (* The Beacon receives on the first initial projection; the chain at
     T_max+1 = 4 is the far anchor. *)
  (* @beaconcrypt-fs-fidelity key=beacon.ratchet_start src=beaconcrypt/src/beacon.rs:459-460 anchor=let pending = start_beacon_candidate_ratchet_kdf(&candidate, derived_secret.as_array()); *)
  let receive_chain_1 = server_to_beacon_chain(root) in
  let receive_chain_2 = ratchet_next(receive_chain_1) in
  let receive_chain_3 = ratchet_next(receive_chain_2) in
  let receive_chain_4 = ratchet_next(receive_chain_3) in
  (* @beaconcrypt-fs-fidelity key=beacon.associated_data src=beaconcrypt/src/beacon.rs:461-461 anchor=let associated_data = *candidate.associated_data(); *)
  (* @beaconcrypt-fs-fidelity key=core.finish_ad src=beaconcrypt-core/src/pqxdh.rs:552-555 anchor=let associated_data = build_associated_data( *)
  let associated_data = beaconcrypt_core__pqxdh__build_associated_data(
    server_identity,
    beacon_identity
  ) in
  let expected_binding = beaconcrypt_core__pqxdh__RegistrationKeyIdBinding(
    key_id_encoding(assigned_key_id)
  ) in
  (* The general receive on the fresh ratchet (r = 0, empty cache) with the
     pinned Server ID as expected sender admits t in 1..51; t = 0 is
     rejected before any open. *)
  (* @beaconcrypt-fs-fidelity key=beacon.receive src=beaconcrypt/src/beacon.rs:462-467 anchor=let decrypted = decrypt_message_with_ratchet( *)
  (* @beaconcrypt-fs-fidelity key=ratchet.decrypt src=beaconcrypt/src/ratchet.rs:499-536 anchor=pub(crate) fn decrypt_message_with_ratchet( *)
  let crypto_frame(
    frame_cipher: bitstring,
    frame_tag: bitstring,
    frame_commitment: bitstring,
    fs_seq(frame_t: nat),
    =SERVER_KEY_ID
  ) = initial_frame in
  if frame_t = 1 then
  (
    let finish_plaintext = open_frame(
      ratchet_material(receive_chain_1),
      associated_data,
      fs_seq(1),
      SERVER_KEY_ID,
      initial_frame
    ) in
    (* @beaconcrypt-fs-fidelity key=beacon.sequence_one src=beaconcrypt/src/beacon.rs:468-470 anchor=if decrypted.seq != 1 { *)
    (* @beaconcrypt-fs-fidelity key=beacon.binding src=beaconcrypt/src/beacon.rs:476-484 anchor=let plaintext = *)
    (* @beaconcrypt-fs-fidelity key=core.binding src=beaconcrypt-core/src/pqxdh.rs:616-628 anchor=pub fn authenticate_registration_key_id_binding( *)
    let registration_payload(
      =expected_binding,
      application_payload: bitstring
    ) = finish_plaintext in
    (* The adapter pin checks cannot fail after the core pin check. *)
    (* @beaconcrypt-fs-fidelity key=beacon.pin_checks src=beaconcrypt/src/beacon.rs:493-502 anchor=let server_binding = authenticated.server_binding(); *)
    (* @beaconcrypt-fs-fidelity key=beacon.commit src=beaconcrypt/src/beacon.rs:503-509 anchor=self.identity_key_kid = authenticated.assigned_key_id(); *)
    event FsBeaconEstablished(
      server_identity,
      beacon_identity,
      init,
      assigned_key_id,
      root,
      associated_data,
      application_payload
    );
    event FsReceived(
      server_to_beacon(),
      server_identity,
      beacon_identity,
      assigned_key_id,
      root,
      1,
      finish_plaintext
    );
    (* Established with receive sequence 1 and an empty cache. *)
    FsS2bRecv1(
      server_identity,
      beacon_identity,
      assigned_key_id,
      root,
      associated_data,
      ratchet_material(receive_chain_2),
      ratchet_material(receive_chain_3),
      receive_chain_4,
      1,
      false
    )
  )
  else if frame_t = 2 then
  (
    (* A later frame opens before the gate. *)
    let later_plaintext_2 = open_frame(
      ratchet_material(receive_chain_2),
      associated_data,
      fs_seq(2),
      SERVER_KEY_ID,
      initial_frame
    ) in
    event FsBeaconFinishOpenedLater(server_identity, beacon_identity, 2);
    FsS2bFinishLater(
      server_identity,
      beacon_identity,
      init,
      assigned_key_id,
      root,
      associated_data,
      expected_binding,
      later_plaintext_2
    )
  )
  else if frame_t = 3 then
  (
    let later_plaintext_3 = open_frame(
      ratchet_material(receive_chain_3),
      associated_data,
      fs_seq(3),
      SERVER_KEY_ID,
      initial_frame
    ) in
    event FsBeaconFinishOpenedLater(server_identity, beacon_identity, 3);
    FsS2bFinishLater(
      server_identity,
      beacon_identity,
      init,
      assigned_key_id,
      root,
      associated_data,
      expected_binding,
      later_plaintext_3
    )
  )
  else 0.

(* Unbounded Server objects sharing the one honest Server identity (OD2);
   unbounded honest Beacons; attacker identities from the public
   constructors. *)
let FsRecordsS2bMain() =
  out(c, ed_public(SERVER_IDENTITY_SECRET));
  (
    (!(new obj: bitstring; FsS2bServer(obj)))
    | (!FsS2bBeacon())
  ).
