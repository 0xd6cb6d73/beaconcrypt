(* The fs-registration process with explicit four-DH nonzero gates. check-primitive-fidelity.py checks exact equality to fs-registration.pvl after erasing only the three listed insertions and comments. Bounds and queries remain separate files. See doc/impl/proverif-primitive-fidelity.md for the scope and unresolved idealisations. *)

def FS_REG_STEP(Cur, Next) {
let Cur(
  obj: bitstring,
  kid_next: nat,
  slot_1: beaconcrypt_core__pqxdh__t_RegistrationId,
  slot_2: beaconcrypt_core__pqxdh__t_RegistrationId
) =
  
  in(c, bundle: bitstring) [precise];
  let server_identity = ed_public(SERVER_IDENTITY_SECRET) in
  
  let signed_init_kex(
    tag_ed25519(identity: bitstring),
    signed_prekey: bitstring,
    signed_one_time: bitstring,
    signed_pq: bitstring
  ) = bundle in

  let (
    tag_mlkem768(pq: bitstring),
    tag_x25519_prekey(prekey: bitstring),
    tag_x25519_one_time(one_time: bitstring)
  ) = (
    verify_signature(signed_pq, identity),
    verify_signature(signed_prekey, identity),
    verify_signature(signed_one_time, identity)
  ) in
  (
    let init = beaconcrypt_core__pqxdh__VerifiedInitKex(
      identity,
      prekey,
      one_time,
      pq
    ) in

    let registration_id = beaconcrypt_core__pqxdh__registration_id(init) in

    if fs_reg_consumed(registration_id, slot_1, slot_2) then
    (
      event FsServerReplayRejected(obj, server_identity, identity, registration_id);
      Next(obj, kid_next, slot_1, slot_2)
    )
    else
    (
      
      new ephemeral_secret: bitstring;
      
      new kem_coins: bitstring;

      let (dh1: bitstring, dh2: bitstring, dh3: bitstring, dh4: bitstring) = (
        x25519_server_dh(SERVER_IDENTITY_SECRET, prekey),
        x25519_server_dh(ephemeral_secret, x25519_public_from_ed(identity)),
        x25519_server_dh(ephemeral_secret, prekey),
        x25519_server_dh(ephemeral_secret, one_time)
      ) in
      (* Reject at the core before root construction; the refusal keeps the entry slots. *)
      if fs_dh_nonzero(dh1, dh2, dh3, dh4) then
      (

        let root = pqxdh_root(
          beaconcrypt_core__pqxdh__t_RootKeyInput_to_bitstring(
            beaconcrypt_core__pqxdh__build_root_key_input(
              beaconcrypt_core__pqxdh__PqxdhSharedSecrets(
                dh1,
                fs_root_dh2(dh2, dh3),
                dh3,
                dh4,
                mlkem_shared_secret(pq, kem_coins)
              )
            )
          )
        ) in
        
        let next_slot_1 =
          if slot_1 = fs_no_rid() then registration_id else slot_1
        in
        let next_slot_2 =
          if slot_1 = fs_no_rid() then slot_2 else registration_id
        in
        
        event FsServerAccepted(
          obj,
          server_identity,
          identity,
          init,
          registration_id,
          root
        );
        
        in(c, control: bitstring) [precise];
        if control = fs_build() then
        (

          let assigned_key_id = fs_kid(kid_next) in

          let server_material_1 =
            ratchet_material(server_to_beacon_chain(root))
          in
          
          let associated_data = fs_associated_data(server_identity, identity) in
          
          new payload: bitstring;
          
          let binding =
            beaconcrypt_core__pqxdh__RegistrationKeyIdBinding(
              key_id_encoding(assigned_key_id)
            )
          in
          
          let initial_frame = seal_frame(
            server_material_1,
            associated_data,
            fs_seq(1),
            SERVER_KEY_ID,
            registration_payload(binding, payload)
          ) in
          
          event FsServerCommitted(
            obj,
            server_identity,
            identity,
            init,
            assigned_key_id,
            root,
            associated_data,
            payload
          );

          out(
            c,
            kex_response(
              server_identity,
              x25519_public(ephemeral_secret),
              mlkem_ciphertext(pq, kem_coins),
              initial_frame,
              assigned_key_id
            )
          );
          Next(obj, kid_next + 1, next_slot_1, next_slot_2)
        )
        else

          Next(obj, kid_next, next_slot_1, next_slot_2)
      )
      else
      (
        event FsServerZeroRejected(obj, server_identity, identity, registration_id);
        event FsServerAcceptFailed(obj, server_identity, identity, registration_id);
        Next(obj, kid_next, slot_1, slot_2)
      )
      else
      (
        
        event FsServerAcceptFailed(obj, server_identity, identity, registration_id);
        Next(obj, kid_next, slot_1, slot_2)
      )
    )
  )
  else
    Next(obj, kid_next, slot_1, slot_2)
  else
    Next(obj, kid_next, slot_1, slot_2).
}

let FsServerRegStop(
  obj: bitstring,
  kid_next: nat,
  slot_1: beaconcrypt_core__pqxdh__t_RegistrationId,
  slot_2: beaconcrypt_core__pqxdh__t_RegistrationId
) = 0.

let FsBeacon() =
  
  new beacon_identity_secret: bitstring;
  new beacon_prekey_secret: bitstring;
  new beacon_pq_secret: bitstring;
  
  new beacon_one_time_secret: bitstring;
  let server_identity = ed_public(SERVER_IDENTITY_SECRET) in
  let beacon_identity = ed_public(beacon_identity_secret) in
  let beacon_prekey = x25519_public(beacon_prekey_secret) in
  let beacon_one_time = x25519_public(beacon_one_time_secret) in
  let beacon_pq = mlkem_public(beacon_pq_secret) in
  let init = beaconcrypt_core__pqxdh__VerifiedInitKex(
    beacon_identity,
    beacon_prekey,
    beacon_one_time,
    beacon_pq
  ) in
  let registration_id = beaconcrypt_core__pqxdh__registration_id(init) in

  event FsBeaconStarted(server_identity, beacon_identity, init, registration_id);

  out(
    c,
    signed_init_kex(
      tag_ed25519(beacon_identity),
      sign(tag_x25519_prekey(beacon_prekey), beacon_identity_secret),
      sign(tag_x25519_one_time(beacon_one_time), beacon_identity_secret),
      sign(tag_mlkem768(beacon_pq), beacon_identity_secret)
    )
  );
  
  in(c, response: bitstring) [precise];
  
  let kex_response(
    response_server_identity,
    server_ephemeral,
    kem_ciphertext,
    initial_frame,
    assigned_key_id
  ) = response in
  
  let server_identity_x = x25519_public_from_ed(response_server_identity) in
  
  let kem_secret = mlkem_decapsulate(kem_ciphertext, beacon_pq_secret) in
  
  let dh1 = x25519_beacon_dh(beacon_prekey_secret, server_identity_x) in
  let dh2 = x25519_beacon_dh(beacon_identity_secret, server_ephemeral) in
  let dh3 = x25519_beacon_dh(beacon_prekey_secret, server_ephemeral) in
  let dh4 = x25519_beacon_dh(beacon_one_time_secret, server_ephemeral) in
  (* Beacon core rejection precedes any root/ratchet use. *)
  if fs_dh_nonzero(dh1, dh2, dh3, dh4) then

  if response_server_identity = server_identity then
  
  let root = pqxdh_root(
    beaconcrypt_core__pqxdh__t_RootKeyInput_to_bitstring(
      beaconcrypt_core__pqxdh__build_root_key_input(
        beaconcrypt_core__pqxdh__PqxdhSharedSecrets(
          dh1,
          fs_root_dh2(dh2, dh3),
          dh3,
          dh4,
          kem_secret
        )
      )
    )
  ) in
  
  let server_material_1 = ratchet_material(server_to_beacon_chain(root)) in

  let associated_data = fs_associated_data(server_identity, beacon_identity) in
  
  let crypto_frame(
    frame_cipher: bitstring,
    frame_tag: bitstring,
    frame_commitment: bitstring,
    frame_sequence: sequence,
    frame_sender: key_id
  ) = initial_frame in
  if frame_sender = SERVER_KEY_ID then
  
  if frame_sequence = fs_seq(1) then
  let registration_payload(binding, application_payload) = open_frame(
    server_material_1,
    associated_data,
    frame_sequence,
    frame_sender,
    initial_frame
  ) in

  if binding = beaconcrypt_core__pqxdh__RegistrationKeyIdBinding(
    key_id_encoding(assigned_key_id)
  ) then

  event FsBeaconEstablished(
    server_identity,
    beacon_identity,
    init,
    assigned_key_id,
    root,
    associated_data,
    application_payload
  ).
