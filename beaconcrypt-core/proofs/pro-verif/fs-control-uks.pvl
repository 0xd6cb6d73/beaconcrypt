(* NEGATIVE CONTROL C-UKS for fs-registration: the session no longer binds
   the Beacon identity.  The root input takes DH3 (ephemeral with the
   prekey) in the DH2 slot, and the associated data keeps the eight-field
   transcript-AD signature but depends only on the Server identity: it drops
   all seven non-Server fields, namely the tagged Beacon identity, the three
   signed request fields (whose Ed25519 signatures would otherwise bind the
   signing Beacon identity), the ephemeral key, the KEM ciphertext and the
   assigned key ID.  The unknown-key-share trace needs only the dropped
   identity binding (the attacker re-signs the honest request keys under its
   own identity and forwards the response unchanged); the other omissions
   are not used by it.  Loaded instead of fs-registration-binding.pvl; A1
   must become FALSE through an unknown-key-share trace. *)
fun fs_uks_ad(bitstring): bitstring.

letfun fs_root_dh2(dh2: bitstring, dh3: bitstring) = dh3.

letfun fs_associated_data(
  encoded_identity: bitstring, signed_prekey: bitstring,
  signed_one_time: bitstring, signed_pq: bitstring,
  server_identity: bitstring, ephemeral: bitstring,
  kem: bitstring, assigned: key_id
) =
  fs_uks_ad(server_identity).
