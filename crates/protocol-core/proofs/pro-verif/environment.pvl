  let material_28 = ratchet_material(chain_28) in
  let material_29 = ratchet_material(chain_29) in
  let material_30 = ratchet_material(chain_30) in
  let material_31 = ratchet_material(chain_31) in
  let material_32 = ratchet_material(chain_32) in
  let material_33 = ratchet_material(chain_33) in
  let material_34 = ratchet_material(chain_34) in
  let material_35 = ratchet_material(chain_35) in
  let material_36 = ratchet_material(chain_36) in
  let material_37 = ratchet_material(chain_37) in
  let material_38 = ratchet_material(chain_38) in
  let material_39 = ratchet_material(chain_39) in
  let material_40 = ratchet_material(chain_40) in
  let material_41 = ratchet_material(chain_41) in
  let material_42 = ratchet_material(chain_42) in
  let material_43 = ratchet_material(chain_43) in
  let material_44 = ratchet_material(chain_44) in
  let material_45 = ratchet_material(chain_45) in
  let material_46 = ratchet_material(chain_46) in
  let material_47 = ratchet_material(chain_47) in
  let material_48 = ratchet_material(chain_48) in
  let material_49 = ratchet_material(chain_49) in
  let material_50 = ratchet_material(chain_50) in
  let material_51 = ratchet_material(chain_51) in
  let future_material = ratchet_material(chain_52) in
  let first_frame = seal_frame(
    material_1,
    associated_data,
    first,
    sender_id,
    FAILED_PAST_SECRET
  ) in
  let skipped_frame = seal_frame(
    skipped_material,
    associated_data,
    skipped_sequence,
    sender_id,
    FAILED_SKIPPED_SECRET
  ) in
  let target_frame = seal_frame(
    retained_material,
    associated_data,
    target_sequence,
    sender_id,
    FAILED_TARGET_SECRET
  ) in
  let future_frame = seal_frame(
    future_material,
    associated_data,
    capacity_sequence,
    sender_id,
    FAILED_FUTURE_SECRET
  ) in
  let forged_target_frame = crypto_frame(
    forged_frame_component(),
    forged_frame_component(),
    forged_frame_component(),
    target_sequence,
    sender_id
  ) in
  let forged_fill_frame = crypto_frame(
    forged_frame_component(),
    forged_frame_component(),
    forged_frame_component(),
    sequence_51,
    sender_id
  ) in
  let forged_capacity_frame = crypto_frame(
    forged_frame_component(),
    forged_frame_component(),
    forged_frame_component(),
    capacity_sequence,
    sender_id
  ) in
  event MessageSent(
    session,
    server_to_beacon(),
    first,
    sender_id,
    receiver_id,
    FAILED_PAST_SECRET
  );
  event MessageSent(
    session,
    server_to_beacon(),
    skipped_sequence,
    sender_id,
    receiver_id,
    FAILED_SKIPPED_SECRET
  );
  event MessageSent(
    session,
    server_to_beacon(),
    target_sequence,
    sender_id,
    receiver_id,
    FAILED_TARGET_SECRET
  );
  event MessageSent(
    session,
    server_to_beacon(),
    capacity_sequence,
    sender_id,
    receiver_id,
    FAILED_FUTURE_SECRET
  );
  out(c, associated_data);
  out(c, first_frame);
  out(c, skipped_frame);
  out(c, target_frame);
  out(c, future_frame);

  (* This ordinary authenticated receive consumes sequence one before any
     attacker-selected future attempt. *)
  in(c, first_candidate: bitstring);
  let first_plaintext = open_frame(
    material_1,
    associated_data,
    first,
    sender_id,
    first_candidate
  ) in
  event MessageReceived(
    session,
    server_to_beacon(),
    first,
    sender_id,
    receiver_id,
    first_plaintext
  );
  event MessageKeyUnavailable(
    session,
    beacon_role(),
    server_to_beacon(),
    first,
    material_1
