(* fs-registration: the consumed-set membership test of one Server object.
   The two slots are the object's consumed registration IDs; an empty slot
   holds fs_no_rid(), which no registration ID equals.  Exactly one of this
   file and the negative control fs-control-nocheck.pvl is loaded. *)
(* @beaconcrypt-fs-fidelity key=consumed.contains src=beaconcrypt/src/server.rs:413-418 anchor=let status = if self.consumed_registrations.contains(&registration_id) { *)
letfun fs_reg_consumed(
  registration_id: beaconcrypt_core__pqxdh__t_RegistrationId,
  slot_1: beaconcrypt_core__pqxdh__t_RegistrationId,
  slot_2: beaconcrypt_core__pqxdh__t_RegistrationId
) =
  registration_id = slot_1 || registration_id = slot_2.
