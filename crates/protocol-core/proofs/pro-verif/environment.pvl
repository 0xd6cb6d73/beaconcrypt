  let material_10 = ratchet_material(chain_10) in
  let material_11 = ratchet_material(chain_11) in
  let material_12 = ratchet_material(chain_12) in
  let material_13 = ratchet_material(chain_13) in
  let material_14 = ratchet_material(chain_14) in
  let material_15 = ratchet_material(chain_15) in
  let material_16 = ratchet_material(chain_16) in
  let material_17 = ratchet_material(chain_17) in
  let material_18 = ratchet_material(chain_18) in
  let material_19 = ratchet_material(chain_19) in
  let material_20 = ratchet_material(chain_20) in
