set traceDisplay = none.
set explainDerivation = false.
set verboseClauses = none.
set verboseRules = false.
set verboseGoalReachable = false.

process
  out(c, ed_public(SERVER_IDENTITY_SECRET));
  (
    !GeneralAdmissionBeacon(BEACON_RECORD_SECRET, first_sequence(), true)
    | !GeneralAdmissionServer(INITIAL_SECRET, CACHED_SECRET, ADVANCE_SECRET, FUTURE_SECRET)
    | !GeneralAdmissionSend()
    | !MaliciousBeacon()
    | !MaliciousServer()
  )
