query k:bitstring,kid:key_id,root:bitstring,t:nat,m:bitstring;
 event(FsReceived(server_to_beacon(),ed_public(SERVER_IDENTITY_SECRET),ed_public(k),kid,root,t,m)) && event(S2bSelectedIdentity(k))
 ==> event(S2bPublished(server_to_beacon(),ed_public(SERVER_IDENTITY_SECRET),ed_public(k),kid,root,t,m)).
process S2bMain(true)
