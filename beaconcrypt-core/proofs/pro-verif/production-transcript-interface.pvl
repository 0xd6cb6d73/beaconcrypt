(* Checked finite-prefix symbolic sorts for production u64 values. *)
type key_id.
type sequence.

fun sequence_le64(sequence): bitstring [data].
fun sender_id_le64(key_id): bitstring [data].
letfun key_id_encoding(identifier: key_id) = sender_id_le64(identifier).

(* Exact disjoint production key encodings: 01 || Ed25519, 03 || ML-KEM-768,
   04 || 80 || X25519 prekey, and 04 || 81 || X25519 one-time key. *)
fun tag_ed25519(bitstring): bitstring [data].
fun tag_x25519_prekey(bitstring): bitstring [data].
fun tag_x25519_one_time(bitstring): bitstring [data].
fun tag_mlkem768(bitstring): bitstring [data].

(* Exact ordered 192-byte root-input serialization boundary. *)
fun pqxdh_ff32_padding(): bitstring [data].
fun pqxdh_root_input(
  bitstring,
  bitstring,
  bitstring,
  bitstring,
  bitstring,
  bitstring
): bitstring [data].

(* Exactly two no-salt HKDF-SHA-512 domains and shared stream projections. *)
type kdf_domain.
type hkdf_stream.

fun pqxdh_domain(): kdf_domain [data].
fun symmetric_ratchet_domain(): kdf_domain [data].
fun hkdf_sha512_no_salt(bitstring, kdf_domain): hkdf_stream.
fun hkdf_first_32(hkdf_stream): bitstring.
fun hkdf_second_32(hkdf_stream): bitstring.
fun hkdf_final_12(hkdf_stream): bitstring.

(* Exact server-first 153-byte associated-data structure using those same
   symbolic domain values. *)
fun beaconcrypt_associated_data(
  bitstring,
  bitstring,
  kdf_domain,
  kdf_domain
): bitstring [data].

(* Unlabeled production AEAD boundary with a detached tag. *)
fun aead_cipher(
  bitstring,
  bitstring,
  bitstring,
  bitstring
): bitstring.
fun aead_tag(
  bitstring,
  bitstring,
  bitstring,
  bitstring
): bitstring.

(* Unlabeled six-field production CTX preimage and ideal BLAKE2b-512 boundary. *)
fun ctx_preimage(
  bitstring,
  bitstring,
  bitstring,
  bitstring,
  bitstring,
  bitstring
): bitstring [data].
fun blake2b512(bitstring): bitstring.

letfun ctx_commitment(
  key: bitstring,
  nonce: bitstring,
  associated_data: bitstring,
  retained_aead_tag: bitstring,
  message_sequence: sequence,
  sender_id: key_id
) =
  blake2b512(
    ctx_preimage(
      key,
      nonce,
      associated_data,
      retained_aead_tag,
      sequence_le64(message_sequence),
      sender_id_le64(sender_id)
    )
  ).

(* The fully typed 18-field constructor is declared after generated extraction
   types in environment.pvl; this shared result type is consumed by every
   production protocol scenario. *)
type establishment_transcript_t.
