def pqxdh.validate_init_kex
  (message : pqxdh.InitKex) :
  RustM (core.result.Result pqxdh.VerifiedInitKex pqxdh.RegistrationError)
  := do
  let o ← pqxdh.untag_sign_key message.identity_key
  match o with
  | core.option.Option.None =>
    ok (core.result.Result.Err pqxdh.RegistrationError.InvalidKeyEncoding)
  | core.option.Option.Some identity =>
    let o1 ← pqxdh.untag_x25519_key message.prekey pqxdh.KEY_ROLE_PREKEY
    match o1 with
    | core.option.Option.None =>
      ok (core.result.Result.Err pqxdh.RegistrationError.InvalidKeyEncoding)
    | core.option.Option.Some prekey =>
      let o2 ←
        pqxdh.untag_x25519_key message.one_time_key pqxdh.KEY_ROLE_ONE_TIME
      match o2 with
      | core.option.Option.None =>
        ok (core.result.Result.Err pqxdh.RegistrationError.InvalidKeyEncoding)
      | core.option.Option.Some one_time =>
        let o3 ← pqxdh.untag_mlkem768_key message.pq_key
        match o3 with
        | core.option.Option.None =>
          ok (core.result.Result.Err
            pqxdh.RegistrationError.InvalidKeyEncoding)
        | core.option.Option.Some pq =>
          ok (core.result.Result.Ok
            {
              beacon_identity_public_key := identity,
              beacon_prekey_public_key := prekey,
              beacon_one_time_public_key := one_time,
              beacon_pq_public_key := pq
            })

