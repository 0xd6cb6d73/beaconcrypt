(* Single-world fresh-secret reachability control, not an equivalence verdict. *)
(* SPDX-License-Identifier: 0BSD *)

(* Active strong-secrecy derivative of the maintained fs process.
   See doc/impl/proverif-active-strong-secrecy.md for the exact bounds,
   test eligibility and source-abstraction obligations. *)

let FsStrongS2bTasking3(server_identity:bitstring,beacon_identity:bitstring,assigned_key_id:key_id,root:bitstring,associated_data:bitstring,send_chain_3:bitstring) =
  in(c,tasking_3:bitstring) ;
  event FsSent(server_to_beacon(),server_identity,beacon_identity,assigned_key_id,root,3,tasking_3);
  out(c,seal_frame(ratchet_material(send_chain_3),associated_data,fs_seq(3),SERVER_KEY_ID,tasking_3)).

let FsStrongS2bSend2(server_identity:bitstring,beacon_identity:bitstring,assigned_key_id:key_id,root:bitstring,associated_data:bitstring,send_chain_2:bitstring,send_chain_3:bitstring,tasking_2:bitstring) =
  event FsSent(server_to_beacon(),server_identity,beacon_identity,assigned_key_id,root,2,tasking_2);
  out(c,seal_frame(ratchet_material(send_chain_2),associated_data,fs_seq(2),SERVER_KEY_ID,tasking_2));
  FsStrongS2bTasking3(server_identity,beacon_identity,assigned_key_id,root,associated_data,send_chain_3).

let FsS2bTaskings(server_identity:bitstring,beacon_identity:bitstring,assigned_key_id:key_id,root:bitstring,associated_data:bitstring,send_chain_2:bitstring,send_chain_3:bitstring) =
  in(c,(test:bool,left:bitstring,right:bitstring)) [precise];
  if test then (
    new fs_strong_control_secret: bitstring;
    event FsStrongControlSecret(fs_strong_control_secret);
    FsStrongS2bSend2(server_identity,beacon_identity,assigned_key_id,root,associated_data,send_chain_2,send_chain_3,fs_strong_control_secret)
  ) else FsStrongS2bSend2(server_identity,beacon_identity,assigned_key_id,root,associated_data,send_chain_2,send_chain_3,left).
