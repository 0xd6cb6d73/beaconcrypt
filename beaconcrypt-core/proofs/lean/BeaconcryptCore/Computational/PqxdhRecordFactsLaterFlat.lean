/-! Flattening the E-only post continuation onto the same native state as the run phase. -/
open OracleComp OracleSpec ENNReal CoreModels Aeneas
open Aeneas.Std hiding namespace core alloc
set_option autoImplicit false

namespace BeaconcryptCore.Computational.PqxdhRecordFactsLaterFlat
open PqxdhRecordLiftInterface PqxdhRecordLiftIdeal PqxdhRecordLiftFlat PqxdhRecordLiftLaterWorlds
open PqxdhRecordLiftProtocol (Control schedule)
open PqxdhDeploymentInterface (Mode ModeSpec FreshBounds Spec FullSpec Handle asModeO)
open PqxdhDeploymentLater (PostSpec postEmbed)
open PqxdhServerAuthExperiment (Setup Codec)
open PqxdhRecordLiftWorldCompiler (Label)
variable {n : Nat} {ι : Type} {baseSpec : OracleSpec ι} {KemSK Reader Response E X Out R : Type}

/-- The post phase executes the permitted post requests through the literal native interpreter; its environment state, control and complete CTX private state are retained. -/
noncomputable def postRun (modes : Label n → KeyMode) (replace : Pqxdh.Bytes → Pqxdh.Bytes)
    (setup : Setup baseSpec KemSK) (codec : Codec Reader Response) (route : RawCtxServerRouting.SenderDecoder)
    (env : Environment n E) (adversary : OracleComp PostSpec Out) (state : NativeState n E) :
    ProbComp (Out × NativeState n E) :=
  (simulateQ (nativeImpl modes replace setup codec route env) (simulateQ postEmbed adversary)).run state

/-- The flattened post interpreter agrees with the existing compiled post phase on every complete input state. -/
theorem postRun_source (modes : Label n → KeyMode) (replace : Pqxdh.Bytes → Pqxdh.Bytes)
    (setup : Setup baseSpec KemSK) (codec : Codec Reader Response) (route : RawCtxServerRouting.SenderDecoder)
    (env : Environment n E) (adversary : OracleComp PostSpec Out) (state : NativeState n E) :
    postRun modes replace setup codec route env adversary state =
      (fun z => (z.1.1.1, ((z.1.1.2, z.1.2), z.2))) <$>
        (simulateQ (ctxInterpreter modes replace setup codec)
          (schedule codec.frameRead route ((PqxdhRecordLiftLater.post env adversary).run state.1.1)
            state.1.2)).run state.2 := by
  unfold postRun PqxdhRecordLiftLater.post schedule nativeImpl clientImpl
  rw [OracleComp.simulateQ_mapStateTBase_run_eq_map_flattenStateT (PqxdhRecordLiftProtocol.handler codec.frameRead route) (native env), simulateQ_map, StateT.run_map, OracleComp.simulateQ_mapStateTBase_run_eq_map_flattenStateT (ctxInterpreter modes replace setup codec)]
  simp only [Functor.map_map, Prod.mk.eta]
  exact (id_map _).symm

/-- The complete later world is startup, the unchanged run-phase flattened ledger interpreter and the E-only post interpreter. The original run ledger is retained exactly. -/
theorem laterCtxRun_flat (modes : Label n → KeyMode) (replace : Pqxdh.Bytes → Pqxdh.Bytes)
    (setup : Setup baseSpec KemSK) (codec : Codec Reader Response) (route : RawCtxServerRouting.SenderDecoder)
    (env : Environment n E) (serverKid : Std.U64) (bounds : FreshBounds) (mode : Mode) (reveal : E → R)
    (first : OracleComp (ModeSpec mode) X) (second : X → R → OracleComp PostSpec Out) :
    laterCtxRun setup codec route env serverKid bounds mode reveal first second modes replace =
      startup modes replace setup codec route env >>= fun born =>
        match born.1.1 with
        | none => pure ((none, born.1.2), born.2)
        | some (created, initial) =>
            install modes replace setup codec route created born.1.2 born.2 >>= fun installed =>
               (simulateQ (fullImpl modes replace setup codec route env serverKid bounds)
                (asModeO mode first)).run
                (PqxdhDeploymentSecrecy.Ledger.empty, ((initial, installed.1.2), installed.2)) >>= fun result =>
              (fun later => ((some (PqxdhRegistrationJointServerBirth.encode created,
                  (later.1, result.2.1), later.2.1.1), later.2.1.2), later.2.2)) <$>
                postRun modes replace setup codec route env
                  (second result.1 (reveal result.2.2.1.1)) result.2.2 := by
  rw [laterCtxRun_split, ctxRun_flat, bind_assoc]
  apply bind_congr
  rintro ⟨⟨_ | ⟨created, initial⟩, control⟩, secret⟩
  all_goals simp only [pure_bind, continueWith, bind_assoc, bind_map_left, postRun_source, Functor.map_map]

/-- A caller-known kernel remains caller-known throughout the post phase, including any administrative capabilities generated by the environment. -/
theorem postRun_known (modes : Label n → KeyMode) (replace : Pqxdh.Bytes → Pqxdh.Bytes)
    (setup : Setup baseSpec KemSK) (codec : Codec Reader Response) (route : RawCtxServerRouting.SenderDecoder)
    (env : Environment n E) (adversary : OracleComp PostSpec Out) (state : NativeState n E)
    (handle : Handle) (known : KnownAt state.1.2 handle) :
    ∀ result ∈ support (postRun modes replace setup codec route env adversary state),
      KnownAt result.2.1.2 handle :=
  support_keep_oracle (nativeImpl modes replace setup codec route env) (fun ns => KnownAt ns.1.2 handle)
    (fun query ns hk => nativeImpl_known modes replace setup codec route env handle query ns hk)
    (simulateQ postEmbed adversary) state known

end BeaconcryptCore.Computational.PqxdhRecordFactsLaterFlat

