import BeaconcryptCore.Computational.RegistrationNativeIdentityTemplateChosenSource
/-! Ordinary joint weak-EUF for a fixed public reserved identity. Every other identity seed is sampled inside the executable reduction; the challenged seed appears only in the primitive interpretation. -/
open OracleComp OracleSpec ENNReal
set_option autoImplicit false
set_option warningAsError true
set_option maxRecDepth 8192
set_option maxHeartbeats 1200000
namespace BeaconcryptCore.Computational.RegistrationNativeIdentityUnissuedChosenGame
open PqxdhJointIdentity (Primitives IdentitySeed PublicIdentity Forgery History AdversarySpec jointImpl wins)
open PqxdhJointIdentityFamily (sampleFamily familyPublic emptyHistory combineHistory)
open PqxdhDynamicIdentityRouting (initialPublicState)
open PqxdhJointIdentityFreshness (GlobalState initialState)
open RegistrationNativeIdentityTemplateProtocol (PublicSpec)
open RegistrationNativeIdentityTemplateChosenSource (Allowed reserved)
open RegistrationNativeIdentityTemplateChosenSuffix (external)
open RegistrationNativeIdentityChosenPublicRouter (Auxiliary project)
variable {count : Nat}

def fixed (joint : Primitives) (target : Fin (count+1)) (others : Fin count → IdentitySeed)
    (work : (Fin (count+1) → PublicIdentity) → OracleComp PublicSpec (Option Forgery))
    (fallback : Forgery) (identity : PublicIdentity) : OracleComp AdversarySpec Forgery :=
  (fun result => result.1.getD fallback) <$>
    (simulateQ (external joint target others identity)
      (work (target.insertNth identity (familyPublic joint others)))).run (initialPublicState,emptyHistory count)

/-- The independent auxiliary seeds are generated by E itself; no reserved private family is an executable input. -/
def reduction (joint : Primitives) (target : Fin (count+1))
    (work : (Fin (count+1) → PublicIdentity) → OracleComp PublicSpec (Option Forgery))
    (fallback : Forgery) (identity : PublicIdentity) : OracleComp AdversarySpec Forgery := do
  let others ← OracleComp.liftComp (sampleFamily count) AdversarySpec
  fixed joint target others work fallback identity

noncomputable def familyGame (joint : Primitives) (target : Fin (count+1))
    (work : (Fin (count+1) → PublicIdentity) → OracleComp PublicSpec (Option Forgery))
    (fallback : Forgery) : ProbComp Bool := do
  let seeds ← sampleFamily (count+1)
  let result ← (simulateQ (reserved joint seeds) (work (familyPublic joint seeds))).run (initialPublicState,initialState (count+1))
  pure (wins joint (familyPublic joint seeds target) (result.1.getD fallback) (result.2.2.histories target))

private theorem project_initial (target : Fin (count+1)) :
    project target [] ((initialPublicState,emptyHistory count),[]) = (initialPublicState,initialState (count+1)) := by
  simp only [project,PqxdhJointIdentityFamily.combineHistory_empty,initialState]

private theorem fixed_source (joint : Primitives) (target : Fin (count+1)) (seed : IdentitySeed)
    (others : Fin count → IdentitySeed)
    (work : (Fin (count+1) → PublicIdentity) → OracleComp PublicSpec (Option Forgery))
    (allowed : ∀ keys, (work keys).AllQueriesSatisfy Allowed) (fallback : Forgery) :
    (fun result => wins joint (joint.publicKeys seed) result.1 result.2) <$>
      PqxdhJointIdentity.run joint seed (fixed joint target others work fallback) =
    (fun result => wins joint (familyPublic joint (target.insertNth seed others) target)
      (result.1.getD fallback) (result.2.2.histories target)) <$>
      (simulateQ (reserved joint (target.insertNth seed others))
        (work (familyPublic joint (target.insertNth seed others)))).run (initialPublicState,initialState (count+1)) := by
  have law := RegistrationNativeIdentityTemplateChosenSource.program joint target seed others []
    (work (target.insertNth (joint.publicKeys seed) (familyPublic joint others))) (allowed _)
    ((initialPublicState,emptyHistory count),[])
  rw [QueryImpl.Stateful.simulateQ_link_run] at law
  rw [project_initial] at law
  have mapped := congrArg (fun distribution => (fun result =>
    wins joint (familyPublic joint (target.insertNth seed others) target)
      (result.1.getD fallback) (result.2.2.histories target)) <$> distribution) law
  simpa only [PqxdhJointIdentity.run,fixed,simulateQ_map,StateT.run_map,Functor.map_map,
    PqxdhJointIdentityFamily.familyPublic_insertNth,Fin.insertNth_apply_same,
    project,combineHistory,QueryImpl.Stateful.Frame.linkReshape,QueryImpl.Stateful.Frame.prod,
    PFunctor.Lens.State.fst_put,PFunctor.Lens.State.snd_put,Prod.map_def,id_eq] using mapped

/-- E's ordinary experiment is the exact complete reserved-family challenge at the fixed public identity, with full real prior histories. -/
theorem game_eq (joint : Primitives) (target : Fin (count+1))
    (work : (Fin (count+1) → PublicIdentity) → OracleComp PublicSpec (Option Forgery))
    (allowed : ∀ keys, (work keys).AllQueriesSatisfy Allowed) (fallback : Forgery) :
    familyGame joint target work fallback =ᵈ PqxdhJointIdentity.game joint (reduction joint target work fallback) := by
  unfold familyGame
  refine (PqxdhJointIdentityFamily.sampleFamily_target_first count target _).trans ?_
  unfold PqxdhJointIdentity.game PqxdhJointIdentity.run reduction
  simp only [simulateQ_bind,StateT.run_bind,PqxdhJointIdentityFamily.simulate_joint_uniform,
    bind_map_left,bind_pure_comp]
  apply EvalDistEq.bind_right
  intro seed
  simp only [map_bind]
  apply EvalDistEq.bind_right
  intro others
  have same := fixed_source joint target seed others work allowed fallback
  rw [← same]
  rfl

/-- The fixed reserved-family field experiment has exactly its ordinary joint weak-EUF advantage; E samples all independent other seeds internally. -/
theorem probability_eq (joint : Primitives) (target : Fin (count+1))
    (work : (Fin (count+1) → PublicIdentity) → OracleComp PublicSpec (Option Forgery))
    (allowed : ∀ keys, (work keys).AllQueriesSatisfy Allowed) (fallback : Forgery) :
    Pr{let result ← familyGame joint target work fallback}[result = true] =
      PqxdhJointIdentity.advantage joint (reduction joint target work fallback) :=
  (game_eq joint target work allowed fallback).prEvent_eq (· = true)

end BeaconcryptCore.Computational.RegistrationNativeIdentityUnissuedChosenGame

